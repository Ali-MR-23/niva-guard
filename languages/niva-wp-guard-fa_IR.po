msgid "You do not have permission to do this."
msgstr "دسترسی مجاز نیست."

msgid "Installed and active"
msgstr "نصب‌شده و فعال"

msgid "Not installed"
msgstr "نصب نشده"

msgid "Outdated"
msgstr "قدیمی"

msgid "The mu-plugins folder is not writable"
msgstr "پوشه‌ی mu-plugins قابل نوشتن نیست"

msgid "Active"
msgstr "فعال"

msgid "Inactive"
msgstr "غیرفعال"

msgid "See which plugin and theme connects where, how much of your site's time it takes, and block every ad with one switch. Cache licenses without cutting them off."
msgstr "ببینید کدام افزونه و قالب به کجا وصل می‌شود، چقدر وقت سایت را می‌گیرد، و هر مورد تبلیغاتی را با یک تیک ببندید. لایسنس‌ها را بدون قطع شدن «کش» کنید."

msgid "Connections recorded"
msgstr "اتصال ثبت‌شده"

msgid "Total wait"
msgstr "مجموع انتظار"

msgid "Blocked"
msgstr "مسدودشده"

msgid "From cache"
msgstr "از کش"

msgid "✓ Settings saved."
msgstr "✓ تنظیمات ذخیره شد."

msgid "✓ Connection report and log file cleared."
msgstr "✓ گزارش اتصال‌ها و فایل لاگ پاک شد."

msgid "✓ The list of skipped hosts was released."
msgstr "✓ فهرست هاست‌های ردشده آزاد شد."

msgid "✓ Plugin code scan completed."
msgstr "✓ اسکن کد افزونه‌ها انجام شد."

msgid "✓ Loader installed."
msgstr "✓ لودر نصب شد."

msgid "✕ Loader installation failed (the mu-plugins folder is not writable)."
msgstr "✕ نصب لودر ناموفق بود (پوشه‌ی mu-plugins قابل نوشتن نیست)."

msgid "Overview"
msgstr "نمای کلی"

msgid "Known connections"
msgstr "اتصال‌های شناخته‌شده"

msgid "Seen on your site"
msgstr "دیده‌شده در سایت شما"

msgid "Take a plugin offline"
msgstr "آفلاین کردن افزونه"

msgid "Dashboard"
msgstr "پیشخوان"

msgid "Auto circuit breaker"
msgstr "قطع‌کننده‌ی خودکار"

msgid "Deep tracking"
msgstr "ردیابی عمیق"

msgid "Manual"
msgstr "دستی"

msgid "General status"
msgstr "وضعیت کلی"

msgid "The master switch turns all blocking and modules on or off at once."
msgstr "کلید اصلی همه‌ی مسدودسازی‌ها و ماژول‌ها را یک‌جا روشن یا خاموش می‌کند."

msgid "Plugin enabled"
msgstr "فعال بودن افزونه"

msgid "Off = no connection is touched."
msgstr "خاموش = هیچ اتصالی دست‌کاری نمی‌شود."

msgid "Log connections"
msgstr "ثبت اتصال‌ها"

msgid "A timed report, in a txt file and in the database."
msgstr "گزارش با زمان، در فایل txt و دیتابیس."

msgid "License response cache time"
msgstr "مدت کش پاسخ لایسنس"

msgid "Less"
msgstr "کمتر"

msgid "hours"
msgstr "ساعت"

msgid "Cache time in hours"
msgstr "مدت کش به ساعت"

msgid "More"
msgstr "بیشتر"

msgid "Preset values"
msgstr "مقدارهای آماده"

msgid "1 hour"
msgstr "۱ ساعت"

msgid "6 hours"
msgstr "۶ ساعت"

msgid "12 hours"
msgstr "۱۲ ساعت"

msgid "1 day"
msgstr "۱ روز"

msgid "3 days"
msgstr "۳ روز"

msgid "A successful license response is kept for this long so the server is not contacted every time."
msgstr "پاسخ موفق لایسنس این مدت نگه داشته می‌شود تا هر بار به سرور وصل نشود."

msgid "Automatic setup and log file"
msgstr "نصب خودکار و فایل لاگ"

msgid "It is created automatically on every new site."
msgstr "روی هر سایت جدید خودکار ساخته می‌شود."

msgid "mu-plugin loader"
msgstr "لودر mu-plugin"

msgid "Install / repair again"
msgstr "نصب / ترمیم دوباره"

msgid "Makes the plugin load before all the others so no connection escapes it."
msgstr "باعث می‌شود افزونه قبل از بقیه بارگذاری شود و هیچ اتصالی از دستش نرود."

msgid "txt log file"
msgstr "فایل لاگ txt"

msgid "Download txt"
msgstr "دانلود txt"

msgid "Download summary report"
msgstr "دانلود گزارش خلاصه"

msgid "It is created with the first connection"
msgstr "با اولین اتصال ساخته می‌شود"

msgid "Report from the txt file"
msgstr "گزارش از روی فایل txt"

msgid "The slowest connections; you can copy this report and send it."
msgstr "کندترین اتصال‌ها؛ همین گزارش را می‌توانید کپی کنید و بفرستید."

msgid "Address"
msgstr "آدرس"

msgid "Plugin / theme"
msgstr "افزونه / قالب"

msgid "Count"
msgstr "دفعات"

msgid "Impact"
msgstr "تأثیر"

msgid "Maximum"
msgstr "حداکثر"

msgid "Report text"
msgstr "متن گزارش"

msgid "Copy"
msgstr "کپی"

msgid "The log file exists but no slow connection (over half a second) has been recorded yet."
msgstr "فایل لاگ هست ولی هنوز اتصال کندی (بالای نیم ثانیه) ثبت نشده."

msgid "There is no report yet. Work with the site and the dashboard for a few minutes and check again."
msgstr "هنوز گزارشی نیست. چند دقیقه با سایت و پیشخوان کار کنید و دوباره سر بزنید."

msgid "“Block” closes the connection completely. “Cache” is for licenses: the same valid response is kept for a few hours and the license is not cut off."
msgstr "«مسدود» اتصال را کامل می‌بندد. «کش» برای لایسنس است: همان پاسخ معتبر چند ساعت نگه داشته می‌شود و لایسنس قطع نمی‌شود."

msgid "Select recommended (ads and notices)"
msgstr "انتخاب پیشنهادی (تبلیغ و اعلان)"

msgid "Clear all"
msgstr "برداشتن همه"

msgid "All"
msgstr "همه"

msgid "Search: plugin, domain or description…"
msgstr "جستجو: افزونه، دامنه یا توضیح…"

msgid "Seen only"
msgstr "فقط دیده‌شده"

msgid "Description and address"
msgstr "توضیح و آدرس"

msgid "Type"
msgstr "نوع"

msgid "Impact on speed"
msgstr "تأثیر روی سرعت"

msgid "Block"
msgstr "مسدود"

msgid "Cache"
msgstr "کش"

msgid "Not seen yet"
msgstr "هنوز دیده نشده"

msgid "Blocking “license” and “plugin function” items may lock a theme or stop SMS and orders from working. For licenses, “cache” is safer. If you tick both “block” and “cache”, block wins."
msgstr "مسدود کردن موارد «لایسنس» و «کارکرد افزونه» ممکن است قفل شدن قالب یا کار نکردن پیامک و سفارش را در پی داشته باشد. برای لایسنس، «کش» امن‌تر است. اگر هم «مسدود» و هم «کش» بزنید، مسدود برنده است."

msgid "Connections seen on your site"
msgstr "اتصال‌های دیده‌شده در سایت شما"

msgid "Items that are not in the known list, ordered by longest wait. Tick one to block that address."
msgstr "مواردی که در فهرست شناخته‌شده نیستند، به‌ترتیب بیشترین زمان انتظار. با تیک، همان آدرس مسدود می‌شود."

msgid "No new connection has been recorded yet. Work with the site and the dashboard for a while and check again."
msgstr "هنوز اتصال جدیدی ثبت نشده. مدتی با سایت و پیشخوان کار کنید و دوباره سر بزنید."

msgid "Type (guess)"
msgstr "نوع (حدس)"

msgid "Search the connections seen…"
msgstr "جستجو در اتصال‌های دیده‌شده…"

msgid "Take a whole plugin offline"
msgstr "آفلاین کردن کامل یک افزونه"

msgid "All external connections of the selected plugin are closed (only wordpress.org stays open). Use it only for plugins that do not need the internet or a license."
msgstr "همه‌ی ارتباط‌های بیرونی افزونه‌ی انتخاب‌شده بسته می‌شود (فقط wordpress.org آزاد می‌ماند). فقط برای افزونه‌هایی که به اینترنت و لایسنس نیاز ندارند."

msgid "Search plugin…"
msgstr "جستجوی افزونه…"

msgid "Ready-made widgets and ads"
msgstr "ویجت‌ها و تبلیغ‌های آماده"

msgid "Each item is switched on separately."
msgstr "هر مورد جدا روشن می‌شود."

msgid "WordPress news widget"
msgstr "ویجت اخبار وردپرس"

msgid "“Events and News” and the planet news."
msgstr "«رویدادها و اخبار» و اخبار سیاره."

msgid "ParsiDate: widget and ads"
msgstr "پارسی‌دیت: ویجت و تبلیغ‌ها"

msgid "The dashboard widget (sponsor banner such as Files.ir and the news feed) is removed and the sponsors.json and wp-parsi.com connections are closed. The Jalali calendar stays untouched."
msgstr "ویجت داشبورد (بنر حامیان مثل Files.ir و فید خبر) حذف می‌شود و اتصال‌های sponsors.json و wp-parsi.com بسته می‌شود. تقویم شمسی دست‌نخورده می‌ماند."

msgid "Elementor news widget"
msgstr "ویجت اخبار المنتور"

msgid "Version and tool ads."
msgstr "تبلیغ نسخه‌ها و ابزارها."

msgid "Yoast widget feed"
msgstr "فید ویجت Yoast"

msgid "The SEO score stays; only the English feed is hidden."
msgstr "امتیاز سئو می‌ماند، فقط فید انگلیسی پنهان می‌شود."

msgid "Jetpack: offline mode"
msgstr "Jetpack: حالت آفلاین"

msgid "The connection to WordPress.com and the Jetpack connections (including the bundle inside WooCommerce) are cut."
msgstr "اتصال به WordPress.com و ارتباط‌های Jetpack (و بسته‌ی آن داخل ووکامرس) قطع می‌شود."

msgid "Persian WooCommerce SMS ads"
msgstr "تبلیغ‌های پیامک ووکامرس فارسی"

msgid "The national SMS banner and plugin install suggestions."
msgstr "بنر ملی پیامک و پیشنهادهای نصب افزونه."

msgid "Hide promotional notices"
msgstr "پنهان کردن اعلان‌های تبلیغاتی"

msgid "Errors and “new version” notices always stay."
msgstr "خطاها و «نسخه جدید» همیشه می‌مانند."

msgid "Enable the keyword filter for notices"
msgstr "فعال کردن فیلتر کلیدواژه‌ای اعلان‌ها"

msgid "One keyword per line, for example: Digits jacket"
msgstr "هر خط یک کلیدواژه، مثلاً: دیجیتس ژاکت"

msgid "Dashboard widgets of this site"
msgstr "ویجت‌های داشبورد این سایت"

msgid "(one switch each)"
msgstr "(هر کدام یک تیک)"

msgid "All the widgets that have been seen on this site's dashboard, with the name of the plugin that created them. A ticked widget is never created, so its feed and ad banner are not fetched from an external server either."
msgstr "همه‌ی ویجت‌هایی که در داشبورد همین سایت دیده شده‌اند، با نام افزونه‌ی سازنده. ویجت تیک‌خورده اصلاً ساخته نمی‌شود، پس فید و بنر تبلیغاتی‌اش هم از سرور بیرونی گرفته نمی‌شود."

msgid "Admin menu (right side)"
msgstr "منوی سمت راست ادمین"

msgid "(only hidden, not removed)"
msgstr "(فقط مخفی می‌شود، نه حذف)"

msgid "Every ticked item is hidden from the side menu. The plugin stays active and its settings still open by direct address. “Dashboard”, “Settings” and “Plugins” are not in this list so you never lose access."
msgstr "هر آیتم تیک‌خورده از منوی کناری پنهان می‌شود. افزونه فعال می‌ماند و تنظیماتش با آدرس مستقیم باز می‌شود. «پیشخوان»، «تنظیمات» و «افزونه‌ها» برای اینکه دسترسی‌تان بسته نشود در این فهرست نیستند."

msgid "There is no list yet. Open another admin page and come back here."
msgstr "هنوز فهرستی نیست. یک صفحه‌ی دیگر ادمین را باز کنید و دوباره به همین‌جا برگردید."

msgid "Remove dashboard widgets of the selected plugins"
msgstr "حذف ویجت‌های داشبوردِ افزونه‌های انتخاب‌شده"

msgid "The widget code does not run and its feed and banner are not fetched from an external server."
msgstr "کد ویجت اجرا نمی‌شود و فید و بنرش از سرور بیرونی گرفته نمی‌شود."

msgid "Some servers sometimes cannot reach external services and wait 5 to 15 seconds every time. With this option, a host that keeps failing or is slow in a row is skipped for a while without waiting."
msgstr "سرور گاهی به سرویس‌های بیرونی نمی‌رسد و هر بار ۵ تا ۱۵ ثانیه معطل می‌شود. با این گزینه، هاستی که پشت‌سرهم خطا یا کندی دارد برای مدتی بدون معطلی رد می‌شود."

msgid "Enable"
msgstr "فعال‌سازی"

msgid "Off by default. “License” addresses are always exempt."
msgstr "پیش‌فرض خاموش. آدرس‌های «لایسنس» همیشه معاف‌اند."

msgid "How long a failing host is skipped (hours)"
msgstr "مدت رد شدن هاست خراب (ساعت)"

msgid "Consecutive failures before it activates"
msgstr "تعداد شکست پشت‌سرهم تا فعال شدن"

msgid "A response slower than this (seconds) also counts as a failure"
msgstr "پاسخ کندتر از این (ثانیه) هم شکست حساب شود"

msgid "Exempt hosts (one per line)"
msgstr "هاست‌های معاف (هر خط یکی)"

msgid "These hosts (and their subdomains) are never skipped, even if they are slow or failing. You can also exempt hosts from the table beside this one."
msgstr "این هاست‌ها (و زیردامنه‌هایشان) هرگز رد نمی‌شوند، حتی اگر کند یا خراب باشند. هاست‌های جدول سمت چپ را هم می‌توانید از همان‌جا معاف کنید."

msgid "Hosts being watched"
msgstr "هاست‌های زیر نظر"

msgid "Only failures recorded since this option was switched on are shown. After the skip period ends it tries once more; if the host is healthy it is removed from the list."
msgstr "فقط شکست‌های ثبت‌شده از وقتی که این گزینه روشن شده نشان داده می‌شود. اولین تلاش بعد از پایان مهلت دوباره امتحان می‌کند؛ اگر سالم بود هاست از فهرست پاک می‌شود."

msgid "No host has been recorded yet."
msgstr "فعلاً هاستی ثبت نشده."

msgid "Host"
msgstr "هاست"

msgid "Status"
msgstr "وضعیت"

msgid "Skip ends"
msgstr "پایان مهلت"

msgid "Times activated"
msgstr "دفعات فعال شدن"

msgid "Last error"
msgstr "آخرین خطا"

msgid "Exempt from the breaker"
msgstr "معاف از قطع‌کننده"

msgid "Release all (clear the list)"
msgstr "آزاد کردن همه (پاک کردن فهرست)"

msgid "1) Intercept direct PHP connections"
msgstr "۱) شنود اتصال‌های مستقیم PHP"

msgid "Enable deep tracking"
msgstr "فعال‌سازی ردیابی عمیق"

msgid "Off by default. Try it on a test site first."
msgstr "پیش‌فرض خاموش است. ابتدا روی سایت آزمایشی امتحان کنید."

msgid "2) Plugin code scan (static)"
msgstr "۲) اسکن کد افزونه‌ها (ایستا)"

msgid "Scan plugin code"
msgstr "اسکن کد افزونه‌ها"

msgid "Nothing found."
msgstr "موردی پیدا نشد."

msgid "Plugin's own code"
msgstr "کد خود افزونه"

msgid "Library (vendor)"
msgstr "کتابخانه (vendor)"

msgid "Fixed destinations in code"
msgstr "مقصدهای ثابت در کد"

msgid "File details were not saved in this scan; scan again."
msgstr "جزئیات فایل‌ها در این اسکن ذخیره نشده؛ دوباره اسکن بزنید."

msgid "File"
msgstr "فایل"

msgid "Line"
msgstr "خط"

msgid "Site / fixed IP inside the file"
msgstr "سایت / IP ثابت داخل فایل"

msgid "Library"
msgstr "کتابخانه"

msgid "Plugin code"
msgstr "کد افزونه"

msgid "“Plugin's own code” means outside the vendor folder. A high count inside libraries is usually harmless. False positives are possible too (for example curl for a local address); to be sure, follow that plugin in the “seen” table."
msgstr "«کد خود افزونه» یعنی خارج از پوشه‌ی vendor. تعداد زیاد در کتابخانه‌ها معمولاً بی‌خطر است. نتیجه‌ی مثبت کاذب هم ممکن است (مثلاً curl برای آدرس لوکال)؛ برای اطمینان، آن افزونه را در جدول «دیده‌شده» دنبال کنید."

msgid "Manual blocking"
msgstr "مسدودسازی دستی"

msgid "Save settings"
msgstr "ذخیره‌ی تنظیمات"

msgid "No changes made"
msgstr "تغییری انجام نشده"

msgid "Clear the connection report"
msgstr "پاک کردن گزارش اتصال‌ها"

msgid "The mu-plugins folder could not be created: %s"
msgstr "پوشه‌ی mu-plugins ساخته نشد: %s"

msgid "The mu-plugins folder is not writable; the plugin works normally but loads later than the others."
msgstr "پوشه‌ی mu-plugins قابل نوشتن نیست؛ افزونه به‌صورت عادی کار می‌کند ولی دیرتر از بقیه بارگذاری می‌شود."

msgid "Writing the loader file failed."
msgstr "نوشتن فایل لودر ناموفق بود."

msgid "Loader installed: %s"
msgstr "لودر نصب شد: %s"

msgid "NIVA WP Guard — connection report"
msgstr "NIVA WP Guard — گزارش اتصال‌ها"

msgid "Site: %1$s | Date: %2$s UTC | Version: %3$s"
msgstr "سایت: %1$s | تاریخ: %2$s UTC | نسخه: %3$s"

msgid "The log file has not been created yet."
msgstr "هنوز فایل لاگ ساخته نشده است."

msgid "Unique connections: %1$d | Slow connections (over 0.5 s): %2$d | Total wait: %3$.1f s | Errors / no response: %4$d"
msgstr "اتصال یکتا: %1$d | اتصال کند (بالای ۰٫۵ ثانیه): %2$d | مجموع انتظار: %3$.1f ثانیه | موارد خطا/بدون پاسخ: %4$d"

msgid "— By plugin (total wait time):"
msgstr "— به تفکیک افزونه (مجموع زمان انتظار):"

msgid "— Slowest addresses:"
msgstr "— کندترین آدرس‌ها:"

msgid "  %1$-60s  %2$d times  total %3$.1fs  max %4$.1fs  errors:%5$d  [%6$s]"
msgstr "  %1$-60s  %2$dبار  مجموع %3$.1fs  حداکثر %4$.1fs  خطا:%5$d  [%6$s]"

msgid "Persian WooCommerce SMS"
msgstr "پیامک ووکامرس فارسی"

msgid "Persian WooCommerce"
msgstr "ووکامرس فارسی"

msgid "Digits (Mersa Web)"
msgstr "Digits (مرسا وب)"

msgid "RTL (RTL-CareUnit)"
msgstr "راست‌چین (RTL-CareUnit)"

msgid "Mahdis Web theme"
msgstr "قالب مهدیس وب"

msgid "Buy with Digikala"
msgstr "خرید با دیجی‌کالا"

msgid "WooCommerce"
msgstr "ووکامرس"

msgid "WordPress — version and plugin updates"
msgstr "وردپرس - بروز رسانی نسخه و افزونه"

msgid "Elementor"
msgstr "المنتور"

msgid "VIP Theme"
msgstr "Yoast (سرور غیر رسمی)"

msgid "ParsiDate"
msgstr "پارسی‌دیت"

msgid "Advanced Shipping (Ace Plugins)"
msgstr "حمل و نقل پیشرفته (Ace Plugins)"

msgid "Emalls"
msgstr "ایمالز"

msgid "Niva plugins"
msgstr "افزونه‌های Niva"

msgid "SMS"
msgstr "پیامک"

msgid "Torob"
msgstr "ترب"

msgid "Notices and ads (pwsms.json / pwsms.hash)"
msgstr "اعلان‌ها و تبلیغات (pwsms.json / pwsms.hash)"

msgid "Notice signature"
msgstr "امضای اعلان‌ها"

msgid "News feed on the dashboard"
msgstr "فید خبر در پیشخوان"

msgid "Advertising panel (ads-api)"
msgstr "پنل تبلیغات (ads-api)"

msgid "Notices and ads"
msgstr "اعلان‌ها و تبلیغات"

msgid "License verification (every few seconds)"
msgstr "تأیید لایسنس (هر چند ثانیه یک‌بار)"

msgid "Product authorization"
msgstr "احراز محصول"

msgid "News feed"
msgstr "فید خبر"

msgid "Version notice (notifier.xml)"
msgstr "اعلان نسخه (notifier.xml)"

msgid "Notices (notifications.json)"
msgstr "اعلان‌ها (notifications.json)"

msgid "Version check (metadata.json)"
msgstr "بررسی نسخه (metadata.json)"

msgid "Order registration and tracking (plugin function)"
msgstr "ثبت و پیگیری سفارش (کارکرد افزونه)"

msgid "Promotional offers and suggested extensions (promotions / obw-free-extensions)"
msgstr "پیشنهادهای تبلیغاتی و افزونه‌های پیشنهادی (promotions / obw-free-extensions)"

msgid "Connection to WordPress.com (public-api): account check, suggestions, payments"
msgstr "اتصال به WordPress.com (public-api): بررسی حساب، پیشنهادها، پرداخت‌ها"

msgid "Jetpack server communication (jetpack.wordpress.com)"
msgstr "ارتباط سرور Jetpack (jetpack.wordpress.com)"

msgid "The jetpack.com site — product recommendations and ads"
