msgstr "Bildirim imzası"

msgid "News feed on the dashboard"
msgstr "Panodaki haber akışı"

msgid "Advertising panel (ads-api)"
msgstr "Reklam paneli (ads-api)"

msgid "Notices and ads"
msgstr "Bildirimler ve reklamlar"

