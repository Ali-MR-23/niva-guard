msgstr "Sürüm bildirimi (notifier.xml)"

msgid "Notices (notifications.json)"
msgstr "Bildirimler (notifications.json)"

msgid "Version check (metadata.json)"
msgstr "Sürüm kontrolü (metadata.json)"

msgid "Order registration and tracking (plugin function)"
msgstr "Sipariş kaydı ve takibi (eklenti işlevi)"

msgid "Promotional offers and suggested extensions (promotions / obw-free-extensions)"
msgstr "Tanıtım teklifleri ve önerilen uzantılar (promotions / obw-free-extensions)"

msgid "Connection to WordPress.com (public-api): account check, suggestions, payments"
msgstr "WordPress.com bağlantısı (public-api): hesap kontrolü, öneriler, ödemeler"

msgid "Jetpack server communication (jetpack.wordpress.com)"
msgstr "Jetpack sunucu iletişimi (jetpack.wordpress.com)"

msgid "The jetpack.com site — product recommendations and ads"
msgstr "jetpack.com sitesi — ürün önerileri ve reklamlar"

msgid "Visit statistics (stats.wp.com)"
msgstr "Ziyaret istatistikleri (stats.wp.com)"

msgid "Tracking pixel (pixel.wp.com)"
msgstr "İzleme pikseli (pixel.wp.com)"

msgid "WooPayments ads (incentives) — the “Set up WooPayments” banner; unrelated to your own payment gateways"
msgstr "WooPayments reklamları (incentives) — “WooPayments’i kurun” afişi; kendi ödeme geçitlerinizle ilgisi yoktur"

msgid "Sending usage statistics to WooCommerce (usage tracking), about half a second"
msgstr "WooCommerce’e kullanım istatistiği gönderme (usage tracking), yaklaşık yarım saniye"

msgid "PayPal (webscr): IPN validation and connecting to PayPal — can wait up to 15 seconds from servers that cannot reach PayPal"
msgstr "PayPal (webscr): IPN doğrulama ve PayPal’a bağlanma — PayPal’a ulaşamayan sunucularda 15 saniyeye kadar bekleyebilir"

msgid "Product key check for WooCommerce.com products (product-key-api)"
msgstr "WooCommerce.com ürünleri için ürün anahtarı kontrolü (product-key-api)"

msgid "WordPress version check from api.wordpress.org (“System status” page; up to 10 seconds on slow hosts)"
msgstr "api.wordpress.org üzerinden WordPress sürüm kontrolü (“Sistem durumu” sayfası; yavaş sunucularda 10 saniyeye kadar)"

msgid "Theme information from api.wordpress.org (“System status” page)"
msgstr "api.wordpress.org üzerinden tema bilgisi (“Sistem durumu” sayfası)"

msgid "QUIC.cloud news and notices (wpapi.quic.cloud/news)"
msgstr "QUIC.cloud haber ve bildirimleri (wpapi.quic.cloud/news)"

msgid "QUIC.cloud version check (ver_check)"
msgstr "QUIC.cloud sürüm kontrolü (ver_check)"

msgid "QUIC.cloud dashboard (api.quic.cloud/d/dash): statistics and cloud service suggestions"
msgstr "QUIC.cloud panosu (api.quic.cloud/d/dash): istatistikler ve bulut hizmeti önerileri"

msgid "solidwp.com news and promotional posts (dashboard widget and notice), up to 10 seconds"
msgstr "solidwp.com haber ve tanıtım yazıları (pano bileşeni ve bildirimi), 10 saniyeye kadar"

msgid "rankmath.com blog news and posts (news widget and dashboard ad)"
msgstr "rankmath.com blog haberleri ve yazıları (haber bileşeni ve pano reklamı)"

msgid "Reading the readme from the WordPress svn (up to 10 seconds)"
msgstr "WordPress svn’den readme okuma (10 saniyeye kadar)"

msgid "Plugin version check"
msgstr "Eklenti sürüm kontrolü"

msgid "Editor ads and notices: upgrade to Pro (free-to-pro-upsell), notifications and promotions — when the editor opens"
msgstr "Düzenleyici reklamları ve bildirimleri: Pro’ya yükseltme (free-to-pro-upsell), bildirimler ve tanıtımlar — düzenleyici açılırken"

msgid "my.elementor.com connections (news, library, suggested plugins)"
msgstr "my.elementor.com bağlantıları (haberler, kütüphane, önerilen eklentiler)"

msgid "Yoast SEO (free) translation packages (translationspress)"
msgstr "Yoast SEO (ücretsiz) çeviri paketleri (translationspress)"

msgid "Yoast SEO Premium translation packages (translationspress)"
msgstr "Yoast SEO Premium çeviri paketleri (translationspress)"

msgid "Yoast WooCommerce SEO translation packages (translationspress)"
msgstr "Yoast WooCommerce SEO çeviri paketleri (translationspress)"

msgid "All Yoast translation packages in one (including News, Local, Video and others)"
msgstr "Tüm Yoast çeviri paketleri tek seferde (News, Local, Video ve diğerleri dahil)"

msgid "vip-themes.com — a third-party server"
msgstr "vip-themes.com — üçüncü taraf bir sunucu"

msgid "Visitor IP check (ipcheck) — also runs on site pages and can wait up to 10 seconds"
msgstr "Ziyaretçi IP kontrolü (ipcheck) — site sayfalarında da çalışır ve 10 saniyeye kadar bekletebilir"

msgid "Add-ons list (addons) — up to 10 seconds"
msgstr "Eklenti listesi (addons) — 10 saniyeye kadar"

msgid "Notices (feeds/notifications)"
msgstr "Bildirimler (feeds/notifications)"

msgid "Sponsors list (sponsors.json from GitHub)"
msgstr "Sponsor listesi (GitHub’dan sponsors.json)"

msgid "News feed (wp-parsi.com)"
msgstr "Haber akışı (wp-parsi.com)"

msgid "Advertising page aceplugins.com"
msgstr "aceplugins.com reklam sayfası"

msgid "IndexNow — notifying search engines about page changes (up to 10 seconds)"
msgstr "IndexNow — sayfa değişikliklerini arama motorlarına bildirme (10 saniyeye kadar)"

msgid "my.yoast.com — site information"
msgstr "my.yoast.com — site bilgileri"

msgid "Upgrade campaign (upgrade-campaign) — advertising; up to 10 seconds"
msgstr "Yükseltme kampanyası (upgrade-campaign) — reklam; 10 saniyeye kadar"

msgid "The entire Wincher connection (keyword tracking: account and connect/token) — up to 10 seconds; block it if you do not use Wincher"
msgstr "Wincher bağlantısının tamamı (anahtar kelime takibi: account ve connect/token) — 10 saniyeye kadar; Wincher kullanmıyorsanız engelleyin"

msgid "Welcome page and ad (cs_welcome.json)"
msgstr "Karşılama sayfası ve reklam (cs_welcome.json)"

msgid "Emalls product extraction service (plugin function)"
msgstr "Emalls ürün çıkarma hizmeti (eklenti işlevi)"

msgid "Niva license server (validate)"
msgstr "Niva lisans sunucusu (validate)"

msgid "payamak-panel SMS gateway"
msgstr "payamak-panel SMS geçidi"

msgid "Price update webhook (Torob)"
msgstr "Fiyat güncelleme webhook’u (Torob)"

msgid "Ad"
msgstr "Reklam"

msgid "Notice / news"
msgstr "Bildirim / haber"

msgid "License"
msgstr "Lisans"

msgid "Version check"
msgstr "Sürüm kontrolü"

msgid "Plugin function"
msgstr "Eklenti işlevi"

msgid "Third party"
msgstr "Üçüncü taraf"

msgid "Status summary: <b>%1$s</b> blocked, <b>%2$s</b> cached, <b>%3$s</b> plugins offline."
msgstr "Durum özeti: <b>%1$s</b> engellendi, <b>%2$s</b> önbelleğe alındı, <b>%3$s</b> eklenti çevrimdışı."

msgid "<b>%1$s</b> unique connections · <b>%2$s</b> slow · total wait <b>%3$s</b> · <b>%4$s</b> errors or no response"
msgstr "<b>%1$s</b> benzersiz bağlantı · <b>%2$s</b> yavaş · toplam bekleme <b>%3$s</b> · <b>%4$s</b> hata veya yanıtsız"

msgid "Skipped"
msgstr "Atlanıyor"

msgid "Counting (%s)"
msgstr "Sayılıyor (%s)"

msgid "Waiting for next try"
msgstr "Sonraki deneme bekleniyor"

msgid "Connections that bypass the WordPress API and go through <code>file_get_contents('http…')</code> or <code>fopen</code> are also recorded in the same table and log (tag \"PHP-GET\"), and the blocking rules apply to them too."
msgstr "WordPress API’sini atlayıp <code>file_get_contents('http…')</code> veya <code>fopen</code> ile giden bağlantılar da aynı tabloda ve günlükte kaydedilir (“PHP-GET” etiketi) ve engelleme kuralları onlara da uygulanır."

msgid "Limits: <code>curl_exec</code> and <code>fsockopen</code> cannot be intercepted live in plain PHP (see section 2). Also, if a plugin reads <code>$http_response_header</code> or <code>get_headers()</code> directly, it may not receive the header data while this option is on; if anything breaks, turn this switch off. Requests made by WordPress core itself (without a calling plugin) are left untouched."
msgstr "Sınırlamalar: <code>curl_exec</code> ve <code>fsockopen</code> düz PHP’de canlı olarak dinlenemez (bölüm 2’ye bakın). Ayrıca bir eklenti <code>$http_response_header</code> veya <code>get_headers()</code> değerini doğrudan okuyorsa, bu seçenek açıkken başlık verisini alamayabilir; bir şey bozulursa bu anahtarı kapatın. WordPress çekirdeğinin kendi istekleri (çağıran eklenti olmadan) olduğu gibi bırakılır."

msgid "allow_url_fopen is disabled on this host; this section has no effect."
msgstr "allow_url_fopen bu sunucuda kapalı; bu bölümün etkisi yok."

msgid "Reads the PHP files of all plugins and themes and lists where <code>curl</code>, <code>fsockopen</code> or <code>file_get_contents('http…')</code> is written directly. It does not run or block anything; it only tells you which plugin has the “ability to connect silently”."
msgstr "Tüm eklenti ve temaların PHP dosyalarını okur ve <code>curl</code>, <code>fsockopen</code> veya <code>file_get_contents('http…')</code> kodunun doğrudan yazıldığı yerleri listeler. Hiçbir şeyi çalıştırmaz veya engellemez; yalnızca hangi eklentinin “sessizce bağlanma yeteneği” olduğunu söyler."

msgid "Last scan: %1$s · %2$s files"
msgstr "Son tarama: %1$s · %2$s dosya"

msgid "· partial (time ran out)"
msgstr "· yarım kaldı (süre doldu)"

msgid "No fixed address — the destination comes from settings or input at run time"
msgstr "Sabit adres yok — hedef çalışma anında ayarlardan veya girdiden gelir"

msgid "One address per line in the form <code>domain/path</code> (prefix); for example <code>example.com/ads/</code>"
msgstr "Her satıra <code>alan/yol</code> biçiminde bir adres (önek); örneğin <code>example.com/ads/</code>"

msgid "%s items"
msgstr "%s öğe"

msgid "This item is of the “license” type. Blocking it may lock a theme or plugin. Turn on “cache” instead. Continue?"
msgstr "Bu öğe “lisans” türünde. Engellemek temayı veya eklentiyi kilitleyebilir. Bunun yerine “önbellek”i açın. Devam edilsin mi?"

msgid "This item is needed for the plugin itself to work (SMS, orders, etc.). Continue?"
msgstr "Bu öğe eklentinin kendi çalışması için gerekli (SMS, siparişler vb.). Devam edilsin mi?"

msgid "%s unsaved changes"
msgstr "%s kaydedilmemiş değişiklik"

msgid "Copied ✓"
msgstr "Kopyalandı ✓"

msgid "Clear the connection report and log file?"
msgstr "Bağlantı raporu ve günlük dosyası temizlensin mi?"

msgid "%1$s times · %2$s ·"
msgstr "%1$s kez · %2$s ·"

msgid "max %s"
msgstr "en çok %s"

msgid "WordPress core"
msgstr "WordPress çekirdeği"

msgid "Theme: %s"
msgstr "Tema: %s"

msgid "There is no list yet. Open the <a href=\"%s\">Dashboard</a> page once and come back here."
msgstr "Henüz liste yok. <a href=\"%s\">Pano</a> sayfasını bir kez açın ve buraya geri dönün."

msgid "Control the outgoing connections of plugins and themes: log every connection with its timing (txt file and report), block ads, notices and news feeds, cache license responses (without cutting them off), take chosen plugins offline, remove promotional dashboard widgets and notices, and skip failing hosts automatically. Every item has its own switch and setup is automatic on every new site."
msgstr "Eklenti ve temaların dışa giden bağlantılarını kontrol edin: her bağlantıyı zamanıyla birlikte kaydedin (txt dosyası ve rapor), reklamları, bildirimleri ve haber akışlarını engelleyin, lisans yanıtlarını (kesmeden) önbelleğe alın, seçili eklentileri çevrimdışı yapın, pano tanıtım bileşenlerini ve bildirimlerini kaldırın ve hata veren ana bilgisayarları otomatik atlayın. Her öğenin kendi anahtarı vardır ve kurulum her yeni sitede otomatiktir."

msgid "The old “NIVA HTTP Guard” plugin is still active. Deactivate it so the new version can work. Your settings are migrated automatically and you can delete the old plugin after the first load."
msgstr "Eski “NIVA HTTP Guard” eklentisi hâlâ etkin. Yeni sürümün çalışması için onu devre dışı bırakın. Ayarlarınız otomatik taşınır ve ilk yüklemeden sonra eski eklentiyi silebilirsiniz."

msgid "Relevant to this site"
msgstr "Bu siteyle ilgili"

msgid "All connections"
msgstr "Tüm bağlantılar"

msgid ".htaccess is up to date (a backup was saved)."
msgstr ".htaccess güncel (yedek kaydedildi)."

msgid "The .htaccess block was removed."
msgstr ".htaccess bloğu kaldırıldı."

msgid "404.html was regenerated."
msgstr "404.html yeniden oluşturuldu."

msgid "Could not write 404.html — download it and upload it to the site root."
msgstr "404.html yazılamadı — indirip sitenin kök dizinine yükleyin."

msgid "The site returned a server error after the change, so .htaccess was restored from the backup."
msgstr "Değişiklikten sonra site sunucu hatası verdi; bu yüzden .htaccess yedekten geri yüklendi."

msgid "This server uses Nginx, which does not use .htaccess. Use the Nginx snippet below."
msgstr "Bu sunucu Nginx kullanıyor ve .htaccess kullanmaz. Aşağıdaki Nginx kodunu kullanın."

msgid "Enable Fast 404 and save first."
msgstr "Önce “Hızlı 404”ü etkinleştirip kaydedin."

msgid "Could not write .htaccess — download the snippet below and add it yourself."
msgstr ".htaccess yazılamadı — aşağıdaki kodu indirip kendiniz ekleyin."

msgid "Server and 404"
msgstr "Sunucu ve 404"

msgid "Installed"
msgstr "Kurulu"

msgid "Outdated — it is updated when you save"
msgstr "Eski — kaydettiğinizde güncellenir"

msgid "Still present — it is removed when you save"
msgstr "Hâlâ duruyor — kaydettiğinizde kaldırılır"

msgid "Not writable"
msgstr "Yazılamıyor"

msgid "Your own file (kept untouched)"
msgstr "Kendi dosyanız (dokunulmaz)"

msgid "Not used on Nginx"
msgstr "Nginx’te kullanılmaz"

msgid "Off"
msgstr "Kapalı"

msgid "WordPress default"
msgstr "WordPress varsayılanı"

msgid "Slow down (use the interval)"
msgstr "Yavaşlat (aralığı kullan)"

msgid "Turn off"
msgstr "Kapat"

msgid "Post editor"
msgstr "Yazı düzenleyici"

msgid "Other admin pages"
msgstr "Diğer yönetim sayfaları"

msgid "Front-end (visitors)"
msgstr "Ön yüz (ziyaretçiler)"

msgid "Heartbeat control"
msgstr "Heartbeat kontrolü"

msgid "WordPress sends a background request (Heartbeat) every 15–60 seconds for autosave, post locking and notices. On weak hosts this alone can overload the server. Control it separately for each part of the site."
msgstr "WordPress otomatik kayıt, yazı kilitleme ve bildirimler için her 15–60 saniyede bir arka plan isteği (Heartbeat) gönderir. Zayıf sunucularda tek başına bu bile sunucuyu yorabilir. Sitenin her bölümü için ayrı ayrı kontrol edin."

msgid "Enable heartbeat control"
msgstr "Heartbeat kontrolünü etkinleştir"

msgid "A separate mu-plugin file is created; off = default WordPress behavior."
msgstr "Ayrı bir mu-plugin dosyası oluşturulur; kapalı = WordPress’in varsayılan davranışı."

msgid "Interval when slowed (seconds)"
msgstr "Yavaşlatma aralığı (saniye)"

msgid "For example 300 = every 5 minutes, 600 = every 10 minutes."
msgstr "Örneğin 300 = 5 dakikada bir, 600 = 10 dakikada bir."

msgid "Turning it off in the post editor disables autosave and post locking while editing."
msgstr "Yazı düzenleyicide kapatmak, düzenleme sırasında otomatik kaydı ve yazı kilitlemeyi devre dışı bırakır."

msgid "mu-plugin file"
msgstr "mu-plugin dosyası"

msgid "Fast 404"
msgstr "Hızlı 404"

msgid "Scanner bots probe hundreds of strange addresses (.env, backup files, fake PHP files). Instead of loading WordPress, the database, CSS and JS for each one, a light static 404 page is returned immediately."
msgstr "Tarama botları yüzlerce garip adres dener (.env, yedek dosyaları, sahte PHP dosyaları). Her biri için WordPress’i, veritabanını, CSS ve JS’yi yüklemek yerine hafif ve statik bir 404 sayfası anında döndürülür."

msgid "Enable fast 404"
msgstr "Hızlı 404’ü etkinleştir"

msgid "Creates a separate mu-plugin, a 404.html page in the site root and a block in .htaccess."
msgstr "Ayrı bir mu-plugin, sitenin kök dizininde bir 404.html sayfası ve .htaccess içinde bir blok oluşturur."

msgid "Strict mode"
msgstr "Sıkı mod"

msgid "Also blocks existing script files outside the WordPress core, plugins and themes folders. May break custom scripts placed in the site root."
msgstr "WordPress çekirdeği, eklenti ve tema klasörleri dışındaki mevcut betik dosyalarını da engeller. Sitenin kök dizinindeki özel betikleri bozabilir."

msgid "Installation status"
msgstr "Kurulum durumu"

msgid "404.html page"
msgstr "404.html sayfası"

msgid ".htaccess block"
msgstr ".htaccess bloğu"

msgid "Install / repair .htaccess"
msgstr ".htaccess’i kur / onar"

msgid "Regenerate 404.html"
msgstr "404.html’i yeniden oluştur"

msgid "Remove .htaccess block"
msgstr ".htaccess bloğunu kaldır"

msgid "Download 404.html"
msgstr "404.html’i indir"

msgid "Download Nginx snippet"
msgstr "Nginx kodunu indir"

msgid "Download .htaccess snippet"
msgstr ".htaccess kodunu indir"

msgid "Nginx configuration"
msgstr "Nginx yapılandırması"

msgid "Code to add to .htaccess"
msgstr ".htaccess’e eklenecek kod"

msgid "Nginx does not use .htaccess; add this to your server configuration. Fake PHP files are handled by the mu-plugin."
msgstr "Nginx .htaccess kullanmaz; bunu sunucu yapılandırmanıza ekleyin. Sahte PHP dosyalarını mu-plugin yakalar."

msgid "If automatic installation is not possible, download the files and place them yourself: put 404.html in the site root (next to wp-config.php) and add this code to the top of .htaccess (before “# BEGIN WordPress”)."
msgstr "Otomatik kurulum mümkün değilse dosyaları indirip kendiniz yerleştirin: 404.html’i sitenin kök dizinine (wp-config.php’nin yanına) koyun ve bu kodu .htaccess’in en üstüne (“# BEGIN WordPress” öncesine) ekleyin."

msgid "Load before other plugins (mu-plugin loader)"
msgstr "Diğer eklentilerden önce yükle (mu-plugin yükleyicisi)"

msgid "Creates one small file in wp-content/mu-plugins. Nothing is created outside the plugin folder until you turn this on and save."
msgstr "wp-content/mu-plugins içinde küçük bir dosya oluşturulur. Bunu açıp kaydedene kadar eklenti klasörünün dışında hiçbir şey oluşturulmaz."

msgid "DISABLE_WP_CRON is already defined in wp-config.php by you, so it was left untouched."
msgstr "DISABLE_WP_CRON zaten wp-config.php içinde sizin tarafınızdan tanımlı, bu yüzden dokunulmadı."

msgid "The site returned a server error after the change, so wp-config.php was restored."
msgstr "Değişiklikten sonra site sunucu hatası verdi, bu yüzden wp-config.php eski haline getirildi."

msgid "Could not find the right place in wp-config.php — add the line shown in the cron card yourself."
msgstr "wp-config.php içinde uygun yer bulunamadı — cron kartında gösterilen satırı kendiniz ekleyin."

msgid "wp-config.php could not be changed automatically — add the line shown in the cron card yourself."
msgstr "wp-config.php otomatik değiştirilemedi — cron kartında gösterilen satırı kendiniz ekleyin."

msgid "WordPress cron (wp-cron)"
msgstr "WordPress cron (wp-cron)"

msgid "By default WordPress runs its scheduled tasks (scheduled posts, emails, backups, WooCommerce jobs) during visitors’ page loads. This slows pages down and wastes resources. Turn it off here and let the server run it on a fixed schedule instead."
msgstr "WordPress varsayılan olarak zamanlanmış görevlerini (zamanlanmış yazılar, e-postalar, yedekler, WooCommerce işleri) ziyaretçiler sayfayı yüklerken çalıştırır. Bu sayfaları yavaşlatır ve kaynak israf eder. Burada kapatın ve sunucunun sabit bir takvimle çalıştırmasını sağlayın."

msgid "Disable the built-in WordPress cron"
msgstr "Yerleşik WordPress cron’unu devre dışı bırak"

msgid "Adds DISABLE_WP_CRON to wp-config.php. Add the server cron job below first, otherwise scheduled tasks stop running."
msgstr "wp-config.php dosyasına DISABLE_WP_CRON ekler. Önce aşağıdaki sunucu cron görevini ekleyin, aksi halde zamanlanmış görevler çalışmaz."

msgid "Run the server job every"
msgstr "Sunucu görevi şu aralıkla çalışsın"

msgid "%s minutes"
msgstr "%s dakika"

msgid "5 minutes suits most sites and shops, 15 minutes is enough for a blog. Use 1 minute only if you need exact timing; more frequent runs only load the server."
msgstr "5 dakika çoğu site ve mağaza için uygundur, blog için 15 dakika yeterlidir. 1 dakikayı yalnızca tam zamanlama gerekiyorsa kullanın; daha sık çalıştırma sunucuyu sadece yorar."

msgid "wp-config.php setting"
msgstr "wp-config.php ayarı"

msgid "Scheduled tasks are %s minutes overdue. Check that the server cron job below exists."
msgstr "Zamanlanmış görevler %s dakika gecikmiş. Aşağıdaki sunucu cron görevinin var olduğundan emin olun."

msgid "Cron job for cPanel"
msgstr "cPanel için cron görevi"

msgid "In cPanel open “Cron Jobs” → “Add New Cron Job”. Enter the schedule (or choose the matching “Common Settings”), paste the command and save."
msgstr "cPanel’de “Cron Jobs” → “Add New Cron Job” bölümünü açın. Zamanlamayı girin (veya uygun “Common Settings” seçin), komutu yapıştırıp kaydedin."

msgid "Schedule (minute, hour, day, month, weekday)"
msgstr "Zamanlama (dakika, saat, gün, ay, haftanın günü)"

msgid "Command (matches this site’s PHP %s)"
msgstr "Komut (bu sitenin PHP %s sürümüne uygun)"

msgid "Other panels and alternative command"
msgstr "Diğer paneller ve alternatif komut"

msgid "The command uses the cPanel path for PHP %1$s (%2$s). On DirectAdmin or other panels replace that path with the PHP path your panel shows for the same version, for example /usr/local/php82/bin/php."
msgstr "Komut, PHP %1$s için cPanel yolunu (%2$s) kullanır. DirectAdmin veya diğer panellerde bu yolu panelinizin aynı sürüm için gösterdiği PHP yolu ile değiştirin, örneğin /usr/local/php82/bin/php."

msgid "If the command above does not run, use this one. It calls the cron file through the web address."
msgstr "Yukarıdaki komut çalışmazsa bunu kullanın; cron dosyasını web adresi üzerinden çağırır."

msgid "If wp-config.php cannot be changed automatically, add this line above “That’s all, stop editing!”:"
msgstr "wp-config.php otomatik değiştirilemiyorsa şu satırı “That’s all, stop editing!” satırının üstüne ekleyin:"

msgid "%s hours"
msgstr "%s saat"

msgid "Longer intervals (hours) lower the server load the most, but scheduled posts, emails and WooCommerce jobs then run later (up to that interval)."
msgstr "Daha uzun aralıklar (saat) sunucu yükünü en çok azaltır, ancak zamanlanmış yazılar, e-postalar ve WooCommerce işleri daha geç (en fazla bu aralık kadar) çalışır."

msgid "This is the full line (schedule + command), ready for crontab. In the cPanel form, enter the schedule in the time fields and paste only the part after it into the Command field."
msgstr "Bu, crontab için hazır tam satırdır (zamanlama + komut). cPanel formunda zamanlamayı zaman alanlarına girin, yalnızca sonrasındaki kısmı Command alanına yapıştırın."

msgid "Cron activity"
msgstr "Cron etkinliği"

msgid "Last successful run"
msgstr "Son başarılı çalıştırma"

msgid "Not recorded yet"
msgstr "Henüz kaydedilmedi"

msgid "Last failed run"
msgstr "Son başarısız çalıştırma"

msgid "Next scheduled task"
msgstr "Sonraki zamanlanmış görev"

msgid "Run by"
msgstr "Çalıştıran"

msgid "Server cron command"
msgstr "Sunucu cron komutu"

msgid "Web request (visitor or URL)"
msgstr "Web isteği (ziyaretçi veya adres)"

msgid "%s ago"
msgstr "%s önce"

msgid "in %s"
msgstr "%s sonra"

msgid "Copy command only"
msgstr "Yalnızca komutu kopyala"

