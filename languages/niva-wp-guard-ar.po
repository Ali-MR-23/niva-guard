msgid "You do not have permission to do this."
msgstr "ليس لديك صلاحية للقيام بهذا الإجراء."

msgid "Installed and active"
msgstr "مثبّت ونشط"

msgid "Not installed"
msgstr "غير مثبّت"

msgid "Outdated"
msgstr "قديم"

msgid "The mu-plugins folder is not writable"
msgstr "مجلد mu-plugins غير قابل للكتابة"

msgid "Active"
msgstr "نشط"

msgid "Inactive"
msgstr "غير نشط"

msgid "See which plugin and theme connects where, how much of your site's time it takes, and block every ad with one switch. Cache licenses without cutting them off."
msgstr "اعرف أي إضافة وقالب تتصل بأي عنوان، وكم من وقت موقعك تستهلك، واحظر كل إعلان بمفتاح واحد. خزّن التراخيص مؤقتًا دون قطعها."

msgid "Connections recorded"
msgstr "اتصالات مسجَّلة"

msgid "Total wait"
msgstr "إجمالي الانتظار"

msgid "Blocked"
msgstr "محظور"

msgid "From cache"
msgstr "من الذاكرة المؤقتة"

msgid "✓ Settings saved."
msgstr "✓ تم حفظ الإعدادات."

msgid "✓ Connection report and log file cleared."
msgstr "✓ تم مسح تقرير الاتصالات وملف السجل."

msgid "✓ The list of skipped hosts was released."
msgstr "✓ تم تحرير قائمة المضيفات المتجاوَزة."

msgid "✓ Plugin code scan completed."
msgstr "✓ اكتمل فحص أكواد الإضافات."

msgid "✓ Loader installed."
msgstr "✓ تم تثبيت المحمّل."

msgid "✕ Loader installation failed (the mu-plugins folder is not writable)."
msgstr "✕ فشل تثبيت المحمّل (مجلد mu-plugins غير قابل للكتابة)."

msgid "Overview"
msgstr "نظرة عامة"

msgid "Known connections"
msgstr "الاتصالات المعروفة"

msgid "Seen on your site"
msgstr "ما شوهد في موقعك"

msgid "Take a plugin offline"
msgstr "عزل إضافة عن الإنترنت"

msgid "Dashboard"
msgstr "لوحة التحكم"

msgid "Auto circuit breaker"
msgstr "قاطع الدائرة التلقائي"

msgid "Deep tracking"
msgstr "التتبع العميق"

msgid "Manual"
msgstr "يدوي"

msgid "General status"
msgstr "الحالة العامة"

msgid "The master switch turns all blocking and modules on or off at once."
msgstr "المفتاح الرئيسي يشغّل أو يوقف كل عمليات الحظر والوحدات دفعة واحدة."

msgid "Plugin enabled"
msgstr "الإضافة مفعّلة"

msgid "Off = no connection is touched."
msgstr "إيقاف = لا يتم التعديل على أي اتصال."

msgid "Log connections"
msgstr "تسجيل الاتصالات"

msgid "A timed report, in a txt file and in the database."
msgstr "تقرير مع التوقيت، في ملف txt وفي قاعدة البيانات."

msgid "License response cache time"
msgstr "مدة تخزين استجابة الترخيص مؤقتًا"

msgid "Less"
msgstr "أقل"

msgid "hours"
msgstr "ساعات"

msgid "Cache time in hours"
msgstr "مدة التخزين المؤقت بالساعات"

msgid "More"
msgstr "أكثر"

msgid "Preset values"
msgstr "قيم جاهزة"

msgid "1 hour"
msgstr "ساعة واحدة"

msgid "6 hours"
msgstr "6 ساعات"

msgid "12 hours"
msgstr "12 ساعة"

msgid "1 day"
msgstr "يوم واحد"

msgid "3 days"
msgstr "3 أيام"

msgid "A successful license response is kept for this long so the server is not contacted every time."
msgstr "تُحفظ استجابة الترخيص الناجحة طوال هذه المدة حتى لا يتم الاتصال بالخادم في كل مرة."

msgid "Automatic setup and log file"
msgstr "الإعداد التلقائي وملف السجل"

msgid "It is created automatically on every new site."
msgstr "يُنشأ تلقائيًا على كل موقع جديد."

msgid "mu-plugin loader"
msgstr "محمّل mu-plugin"

msgid "Install / repair again"
msgstr "تثبيت / إصلاح من جديد"

msgid "Makes the plugin load before all the others so no connection escapes it."
msgstr "يجعل الإضافة تُحمَّل قبل البقية فلا يفلت أي اتصال منها."

msgid "txt log file"
msgstr "ملف السجل txt"

msgid "Download txt"
msgstr "تنزيل txt"

msgid "Download summary report"
msgstr "تنزيل التقرير الموجز"

msgid "It is created with the first connection"
msgstr "يُنشأ عند أول اتصال"

msgid "Report from the txt file"
msgstr "تقرير من ملف txt"

msgid "The slowest connections; you can copy this report and send it."
msgstr "أبطأ الاتصالات؛ يمكنك نسخ هذا التقرير وإرساله."

msgid "Address"
msgstr "العنوان"

msgid "Plugin / theme"
msgstr "الإضافة / القالب"

msgid "Count"
msgstr "العدد"

msgid "Impact"
msgstr "التأثير"

msgid "Maximum"
msgstr "الحد الأقصى"

msgid "Report text"
msgstr "نص التقرير"

msgid "Copy"
msgstr "نسخ"

msgid "The log file exists but no slow connection (over half a second) has been recorded yet."
msgstr "ملف السجل موجود لكن لم يُسجَّل بعد أي اتصال بطيء (أكثر من نصف ثانية)."

msgid "There is no report yet. Work with the site and the dashboard for a few minutes and check again."
msgstr "لا يوجد تقرير بعد. اعمل على الموقع ولوحة التحكم بضع دقائق ثم عُد."

msgid "“Block” closes the connection completely. “Cache” is for licenses: the same valid response is kept for a few hours and the license is not cut off."
msgstr "«حظر» يغلق الاتصال تمامًا. «تخزين مؤقت» مخصص للتراخيص: تُحفظ الاستجابة الصحيحة نفسها عدة ساعات ولا ينقطع الترخيص."

msgid "Select recommended (ads and notices)"
msgstr "اختيار الموصى به (إعلانات وإشعارات)"

msgid "Clear all"
msgstr "إلغاء تحديد الكل"

msgid "All"
msgstr "الكل"

msgid "Search: plugin, domain or description…"
msgstr "بحث: إضافة أو نطاق أو وصف…"

msgid "Seen only"
msgstr "المشاهَد فقط"

msgid "Description and address"
msgstr "الوصف والعنوان"

msgid "Type"
msgstr "النوع"

msgid "Impact on speed"
msgstr "التأثير على السرعة"

msgid "Block"
msgstr "حظر"

msgid "Cache"
msgstr "تخزين مؤقت"

msgid "Not seen yet"
msgstr "لم يُشاهَد بعد"

msgid "Blocking “license” and “plugin function” items may lock a theme or stop SMS and orders from working. For licenses, “cache” is safer. If you tick both “block” and “cache”, block wins."
msgstr "حظر عناصر «الترخيص» و«وظيفة الإضافة» قد يؤدي إلى قفل القالب أو توقف الرسائل النصية والطلبات. للتراخيص، «التخزين المؤقت» أكثر أمانًا. إذا حددت «حظر» و«تخزين مؤقت» معًا فالحظر هو الأقوى."

msgid "Connections seen on your site"
msgstr "الاتصالات المشاهَدة في موقعك"

msgid "Items that are not in the known list, ordered by longest wait. Tick one to block that address."
msgstr "عناصر غير موجودة في القائمة المعروفة، مرتبة حسب أطول انتظار. حدّد عنصرًا لحظر عنوانه."

msgid "No new connection has been recorded yet. Work with the site and the dashboard for a while and check again."
msgstr "لم يُسجَّل أي اتصال جديد بعد. اعمل على الموقع ولوحة التحكم قليلًا ثم عُد."

msgid "Type (guess)"
msgstr "النوع (تخمين)"

msgid "Search the connections seen…"
msgstr "البحث في الاتصالات المشاهَدة…"

msgid "Take a whole plugin offline"
msgstr "عزل إضافة كاملة عن الإنترنت"

msgid "All external connections of the selected plugin are closed (only wordpress.org stays open). Use it only for plugins that do not need the internet or a license."
msgstr "تُغلق كل الاتصالات الخارجية للإضافة المحددة (يبقى wordpress.org فقط مفتوحًا). استخدمه فقط للإضافات التي لا تحتاج إلى الإنترنت أو ترخيص."

msgid "Search plugin…"
msgstr "ابحث عن إضافة…"

msgid "Ready-made widgets and ads"
msgstr "ودجات وإعلانات جاهزة"

msgid "Each item is switched on separately."
msgstr "يُفعَّل كل عنصر على حدة."

msgid "WordPress news widget"
msgstr "ودجة أخبار ووردبريس"

msgid "“Events and News” and the planet news."
msgstr "«الأحداث والأخبار» وأخبار الكوكب."

msgid "ParsiDate: widget and ads"
msgstr "ParsiDate: الودجة والإعلانات"

msgid "The dashboard widget (sponsor banner such as Files.ir and the news feed) is removed and the sponsors.json and wp-parsi.com connections are closed. The Jalali calendar stays untouched."
msgstr "تُحذف ودجة لوحة التحكم (لافتة الرعاة مثل Files.ir وموجز الأخبار) وتُغلق اتصالات sponsors.json وwp-parsi.com. يبقى التقويم الشمسي كما هو."

msgid "Elementor news widget"
msgstr "ودجة أخبار Elementor"

msgid "Version and tool ads."
msgstr "إعلانات الإصدارات والأدوات."

msgid "Yoast widget feed"
msgstr "موجز ودجة Yoast"

msgid "The SEO score stays; only the English feed is hidden."
msgstr "تبقى درجة SEO؛ يُخفى الموجز الإنجليزي فقط."

msgid "Jetpack: offline mode"
msgstr "Jetpack: وضع عدم الاتصال"

msgid "The connection to WordPress.com and the Jetpack connections (including the bundle inside WooCommerce) are cut."
msgstr "يُقطع الاتصال بـ WordPress.com واتصالات Jetpack (بما فيها الحزمة داخل WooCommerce)."

msgid "Persian WooCommerce SMS ads"
msgstr "إعلانات الرسائل النصية لـ WooCommerce الفارسي"

msgid "The national SMS banner and plugin install suggestions."
msgstr "لافتة الرسائل النصية الوطنية واقتراحات تثبيت الإضافات."

msgid "Hide promotional notices"
msgstr "إخفاء الإشعارات الترويجية"

msgid "Errors and “new version” notices always stay."
msgstr "تبقى الأخطاء وإشعارات «إصدار جديد» دائمًا."

msgid "Enable the keyword filter for notices"
msgstr "تفعيل مرشّح الكلمات المفتاحية للإشعارات"

msgid "One keyword per line, for example: Digits jacket"
msgstr "كلمة مفتاحية في كل سطر، مثلًا: Digits jacket"

msgid "Dashboard widgets of this site"
msgstr "ودجات لوحة التحكم في هذا الموقع"

msgid "(one switch each)"
msgstr "(مفتاح لكل واحدة)"

msgid "All the widgets that have been seen on this site's dashboard, with the name of the plugin that created them. A ticked widget is never created, so its feed and ad banner are not fetched from an external server either."
msgstr "كل الودجات التي شوهدت في لوحة تحكم هذا الموقع، مع اسم الإضافة المنشئة لها. الودجة المحددة لا تُنشأ أصلًا، فلا يُجلب موجزها ولا لافتتها الإعلانية من خادم خارجي."

msgid "Admin menu (right side)"
msgstr "قائمة الإدارة (الجانب)"

msgid "(only hidden, not removed)"
msgstr "(تُخفى فقط، لا تُحذف)"

msgid "Every ticked item is hidden from the side menu. The plugin stays active and its settings still open by direct address. “Dashboard”, “Settings” and “Plugins” are not in this list so you never lose access."
msgstr "كل عنصر محدد يُخفى من القائمة الجانبية. تبقى الإضافة نشطة وتُفتح إعداداتها بالعنوان المباشر. «لوحة التحكم» و«الإعدادات» و«الإضافات» ليست في هذه القائمة حتى لا تفقد الوصول."

msgid "There is no list yet. Open another admin page and come back here."
msgstr "لا توجد قائمة بعد. افتح صفحة إدارة أخرى ثم عُد إلى هنا."

msgid "Remove dashboard widgets of the selected plugins"
msgstr "حذف ودجات لوحة التحكم للإضافات المحددة"

msgid "The widget code does not run and its feed and banner are not fetched from an external server."
msgstr "لا يُنفَّذ كود الودجة ولا يُجلب موجزها ولا لافتتها من خادم خارجي."

msgid "Some servers sometimes cannot reach external services and wait 5 to 15 seconds every time. With this option, a host that keeps failing or is slow in a row is skipped for a while without waiting."
msgstr "قد لا يستطيع الخادم أحيانًا الوصول إلى الخدمات الخارجية فينتظر من 5 إلى 15 ثانية في كل مرة. مع هذا الخيار يتم تجاوز المضيف الذي يفشل أو يبطؤ باستمرار لفترة دون انتظار."

msgid "Enable"
msgstr "تفعيل"

msgid "Off by default. “License” addresses are always exempt."
msgstr "متوقف افتراضيًا. عناوين «الترخيص» مستثناة دائمًا."

msgid "How long a failing host is skipped (hours)"
msgstr "مدة تجاوز المضيف المعطل (ساعات)"

msgid "Consecutive failures before it activates"
msgstr "عدد الإخفاقات المتتالية قبل التفعيل"

msgid "A response slower than this (seconds) also counts as a failure"
msgstr "الاستجابة الأبطأ من هذا (بالثواني) تُحسب إخفاقًا أيضًا"

msgid "Exempt hosts (one per line)"
msgstr "مضيفات مستثناة (واحد في كل سطر)"

msgid "These hosts (and their subdomains) are never skipped, even if they are slow or failing. You can also exempt hosts from the table beside this one."
msgstr "هذه المضيفات (ونطاقاتها الفرعية) لا تُتجاوَز أبدًا حتى لو كانت بطيئة أو معطلة. يمكنك أيضًا استثناء مضيفات من الجدول المجاور."

msgid "Hosts being watched"
msgstr "المضيفات قيد المراقبة"

msgid "Only failures recorded since this option was switched on are shown. After the skip period ends it tries once more; if the host is healthy it is removed from the list."
msgstr "تُعرض فقط الإخفاقات المسجَّلة منذ تفعيل هذا الخيار. بعد انتهاء مدة التجاوز يحاول مرة أخرى؛ وإذا كان المضيف سليمًا يُحذف من القائمة."

msgid "No host has been recorded yet."
msgstr "لم يُسجَّل أي مضيف بعد."

msgid "Host"
msgstr "المضيف"

msgid "Status"
msgstr "الحالة"

msgid "Skip ends"
msgstr "انتهاء التجاوز"

msgid "Times activated"
msgstr "عدد مرات التفعيل"

msgid "Last error"
msgstr "آخر خطأ"

msgid "Exempt from the breaker"
msgstr "مستثنى من القاطع"

msgid "Release all (clear the list)"
msgstr "تحرير الكل (مسح القائمة)"

msgid "1) Intercept direct PHP connections"
msgstr "1) اعتراض اتصالات PHP المباشرة"

msgid "Enable deep tracking"
msgstr "تفعيل التتبع العميق"

msgid "Off by default. Try it on a test site first."
msgstr "متوقف افتراضيًا. جرّبه أولًا على موقع تجريبي."

msgid "2) Plugin code scan (static)"
msgstr "2) فحص أكواد الإضافات (ثابت)"

msgid "Scan plugin code"
msgstr "فحص أكواد الإضافات"

msgid "Nothing found."
msgstr "لم يُعثر على شيء."

msgid "Plugin's own code"
msgstr "كود الإضافة نفسها"

msgid "Library (vendor)"
msgstr "مكتبة (vendor)"

msgid "Fixed destinations in code"
msgstr "وجهات ثابتة في الكود"

msgid "File details were not saved in this scan; scan again."
msgstr "لم تُحفظ تفاصيل الملفات في هذا الفحص؛ أعد الفحص."

msgid "File"
msgstr "الملف"

msgid "Line"
msgstr "السطر"

msgid "Site / fixed IP inside the file"
msgstr "موقع / IP ثابت داخل الملف"

msgid "Library"
msgstr "مكتبة"

msgid "Plugin code"
msgstr "كود الإضافة"

msgid "“Plugin's own code” means outside the vendor folder. A high count inside libraries is usually harmless. False positives are possible too (for example curl for a local address); to be sure, follow that plugin in the “seen” table."
msgstr "«كود الإضافة نفسها» يعني خارج مجلد vendor. العدد الكبير داخل المكتبات غالبًا غير ضار. وقد تظهر نتائج إيجابية كاذبة (مثل curl لعنوان محلي)؛ وللتأكد، تابع تلك الإضافة في جدول «المشاهَد»."

msgid "Manual blocking"
msgstr "الحظر اليدوي"

msgid "Save settings"
msgstr "حفظ الإعدادات"

msgid "No changes made"
msgstr "لم يتم أي تغيير"

msgid "Clear the connection report"
msgstr "مسح تقرير الاتصالات"

msgid "The mu-plugins folder could not be created: %s"
msgstr "تعذّر إنشاء مجلد mu-plugins: %s"

msgid "The mu-plugins folder is not writable; the plugin works normally but loads later than the others."
msgstr "مجلد mu-plugins غير قابل للكتابة؛ تعمل الإضافة بشكل عادي لكنها تُحمَّل بعد البقية."

msgid "Writing the loader file failed."
msgstr "فشلت كتابة ملف المحمّل."

msgid "Loader installed: %s"
msgstr "تم تثبيت المحمّل: %s"

msgid "NIVA WP Guard — connection report"
msgstr "NIVA WP Guard — تقرير الاتصالات"

msgid "Site: %1$s | Date: %2$s UTC | Version: %3$s"
msgstr "الموقع: %1$s | التاريخ: %2$s UTC | الإصدار: %3$s"

msgid "The log file has not been created yet."
msgstr "لم يُنشأ ملف السجل بعد."

msgid "Unique connections: %1$d | Slow connections (over 0.5 s): %2$d | Total wait: %3$.1f s | Errors / no response: %4$d"
msgstr "اتصالات فريدة: %1$d | اتصالات بطيئة (أكثر من 0.5 ث): %2$d | إجمالي الانتظار: %3$.1f ث | أخطاء / بلا استجابة: %4$d"

msgid "— By plugin (total wait time):"
msgstr "— حسب الإضافة (إجمالي زمن الانتظار):"

msgid "— Slowest addresses:"
msgstr "— أبطأ العناوين:"

msgid "  %1$-60s  %2$d times  total %3$.1fs  max %4$.1fs  errors:%5$d  [%6$s]"
msgstr "  %1$-60s  %2$d مرات  الإجمالي %3$.1fs  الأقصى %4$.1fs  أخطاء:%5$d  [%6$s]"

msgid "Persian WooCommerce SMS"
msgstr "رسائل WooCommerce الفارسي"

msgid "Persian WooCommerce"
msgstr "WooCommerce الفارسي"

msgid "Digits (Mersa Web)"
msgstr "Digits (Mersa Web)"

msgid "RTL (RTL-CareUnit)"
msgstr "RTL (RTL-CareUnit)"

msgid "Mahdis Web theme"
msgstr "قالب Mahdis Web"

msgid "Buy with Digikala"
msgstr "الشراء عبر ديجي كالا"

msgid "WooCommerce"
msgstr "WooCommerce"

msgid "WordPress — version and plugin updates"
msgstr "WordPress — تحديثات الإصدار والإضافات"

msgid "Elementor"
msgstr "Elementor"

msgid "VIP Theme"
msgstr "VIP Theme"

msgid "ParsiDate"
msgstr "ParsiDate"

msgid "Advanced Shipping (Ace Plugins)"
msgstr "Advanced Shipping (Ace Plugins)"

msgid "Emalls"
msgstr "Emalls"

msgid "Niva plugins"
msgstr "إضافات Niva"

msgid "SMS"
msgstr "رسائل SMS"

msgid "Torob"
msgstr "Torob"

msgid "Notices and ads (pwsms.json / pwsms.hash)"
msgstr "إشعارات وإعلانات (pwsms.json / pwsms.hash)"

msgid "Notice signature"
msgstr "توقيع الإشعارات"

msgid "News feed on the dashboard"
msgstr "موجز الأخبار في لوحة التحكم"

msgid "Advertising panel (ads-api)"
msgstr "لوحة الإعلانات (ads-api)"

msgid "Notices and ads"
msgstr "إشعارات وإعلانات"

msgid "License verification (every few seconds)"
msgstr "التحقق من الترخيص (كل بضع ثوانٍ)"

msgid "Product authorization"
msgstr "تفويض المنتج"

msgid "News feed"
msgstr "موجز الأخبار"

msgid "Version notice (notifier.xml)"
msgstr "إشعار الإصدار (notifier.xml)"

msgid "Notices (notifications.json)"
msgstr "الإشعارات (notifications.json)"

msgid "Version check (metadata.json)"
msgstr "فحص الإصدار (metadata.json)"

msgid "Order registration and tracking (plugin function)"
msgstr "تسجيل الطلبات وتتبعها (وظيفة الإضافة)"

msgid "Promotional offers and suggested extensions (promotions / obw-free-extensions)"
msgstr "عروض ترويجية وإضافات مقترحة (promotions / obw-free-extensions)"

msgid "Connection to WordPress.com (public-api): account check, suggestions, payments"
msgstr "الاتصال بـ WordPress.com (public-api): فحص الحساب والاقتراحات والمدفوعات"

msgid "Jetpack server communication (jetpack.wordpress.com)"
msgstr "اتصال خادم Jetpack (jetpack.wordpress.com)"

msgid "The jetpack.com site — product recommendations and ads"
msgstr "موقع jetpack.com — توصيات وإعلانات المنتجات"

msgid "Visit statistics (stats.wp.com)"
msgstr "إحصاءات الزيارات (stats.wp.com)"

msgid "Tracking pixel (pixel.wp.com)"
msgstr "بكسل التتبع (pixel.wp.com)"

msgid "WooPayments ads (incentives) — the “Set up WooPayments” banner; unrelated to your own payment gateways"
msgstr "إعلانات WooPayments (incentives) — لافتة «فعّل WooPayments»؛ لا علاقة لها ببوابات الدفع الخاصة بك"

msgid "Sending usage statistics to WooCommerce (usage tracking), about half a second"
