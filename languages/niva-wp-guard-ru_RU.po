msgstr "Все пакеты перевода Yoast сразу (включая News, Local, Video и другие)"

msgid "vip-themes.com — a third-party server, not Yoast"
msgstr "vip-themes.com — сторонний сервер, не Yoast"

msgid "Visitor IP check (ipcheck) — also runs on site pages and can wait up to 10 seconds"
msgstr "Проверка IP посетителя (ipcheck) — выполняется и на страницах сайта и может ждать до 10 секунд"

msgid "Add-ons list (addons) — up to 10 seconds"
