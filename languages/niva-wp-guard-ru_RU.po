msgid "You do not have permission to do this."
msgstr "У вас нет прав для этого действия."

msgid "Installed and active"
msgstr "Установлен и активен"

msgid "Not installed"
msgstr "Не установлен"

msgid "Outdated"
msgstr "Устарел"

msgid "The mu-plugins folder is not writable"
msgstr "Папка mu-plugins недоступна для записи"

msgid "Active"
msgstr "Активен"

msgid "Inactive"
msgstr "Неактивен"

msgid "See which plugin and theme connects where, how much of your site's time it takes, and block every ad with one switch. Cache licenses without cutting them off."
msgstr "Узнайте, какой плагин и какая тема куда подключается, сколько времени сайта это занимает, и блокируйте любую рекламу одним переключателем. Кэшируйте лицензии, не обрывая их."

msgid "Connections recorded"
msgstr "Записано подключений"

msgid "Total wait"
msgstr "Общее ожидание"

msgid "Blocked"
msgstr "Заблокировано"

msgid "From cache"
msgstr "Из кэша"

msgid "✓ Settings saved."
msgstr "✓ Настройки сохранены."

msgid "✓ Connection report and log file cleared."
msgstr "✓ Отчёт о подключениях и файл журнала очищены."

msgid "✓ The list of skipped hosts was released."
msgstr "✓ Список пропускаемых хостов сброшен."

msgid "✓ Plugin code scan completed."
msgstr "✓ Сканирование кода плагинов завершено."

msgid "✓ Loader installed."
msgstr "✓ Загрузчик установлен."

msgid "✕ Loader installation failed (the mu-plugins folder is not writable)."
msgstr "✕ Не удалось установить загрузчик (папка mu-plugins недоступна для записи)."

msgid "Overview"
msgstr "Обзор"

msgid "Known connections"
msgstr "Известные подключения"

msgid "Seen on your site"
msgstr "Замечено на вашем сайте"

msgid "Take a plugin offline"
msgstr "Отключить плагин от сети"

msgid "Dashboard"
msgstr "Консоль"

msgid "Auto circuit breaker"
msgstr "Автоматический предохранитель"

msgid "Deep tracking"
msgstr "Глубокое отслеживание"

msgid "Manual"
msgstr "Вручную"

msgid "General status"
msgstr "Общее состояние"

msgid "The master switch turns all blocking and modules on or off at once."
msgstr "Главный переключатель включает или выключает все блокировки и модули сразу."

msgid "Plugin enabled"
msgstr "Плагин включён"

msgid "Off = no connection is touched."
msgstr "Выключено = ни одно подключение не затрагивается."

msgid "Log connections"
msgstr "Записывать подключения"

msgid "A timed report, in a txt file and in the database."
msgstr "Отчёт с временем — в txt-файле и в базе данных."

msgid "License response cache time"
msgstr "Время кэширования ответа лицензии"

msgid "Less"
msgstr "Меньше"

msgid "hours"
msgstr "ч"

msgid "Cache time in hours"
msgstr "Время кэша в часах"

msgid "More"
msgstr "Больше"

msgid "Preset values"
msgstr "Готовые значения"

msgid "1 hour"
msgstr "1 час"

msgid "6 hours"
msgstr "6 часов"

msgid "12 hours"
msgstr "12 часов"

msgid "1 day"
msgstr "1 день"

msgid "3 days"
msgstr "3 дня"

msgid "A successful license response is kept for this long so the server is not contacted every time."
msgstr "Успешный ответ лицензии хранится столько времени, чтобы не обращаться к серверу каждый раз."

msgid "Automatic setup and log file"
msgstr "Автоматическая установка и файл журнала"

msgid "It is created automatically on every new site."
msgstr "Создаётся автоматически на каждом новом сайте."

msgid "mu-plugin loader"
msgstr "Загрузчик mu-plugin"

msgid "Install / repair again"
msgstr "Установить / восстановить заново"

msgid "Makes the plugin load before all the others so no connection escapes it."
msgstr "Заставляет плагин загружаться раньше остальных, чтобы ни одно подключение не ускользнуло."

msgid "txt log file"
msgstr "Файл журнала txt"

msgid "Download txt"
msgstr "Скачать txt"

msgid "Download summary report"
msgstr "Скачать краткий отчёт"

msgid "It is created with the first connection"
msgstr "Создаётся при первом подключении"

msgid "Report from the txt file"
msgstr "Отчёт из txt-файла"

msgid "The slowest connections; you can copy this report and send it."
msgstr "Самые медленные подключения; этот отчёт можно скопировать и отправить."

msgid "Address"
msgstr "Адрес"

msgid "Plugin / theme"
msgstr "Плагин / тема"

msgid "Count"
msgstr "Количество"

msgid "Impact"
msgstr "Влияние"

msgid "Maximum"
msgstr "Максимум"

msgid "Report text"
msgstr "Текст отчёта"

msgid "Copy"
msgstr "Копировать"

msgid "The log file exists but no slow connection (over half a second) has been recorded yet."
msgstr "Файл журнала есть, но медленных подключений (дольше полусекунды) пока не записано."

msgid "There is no report yet. Work with the site and the dashboard for a few minutes and check again."
msgstr "Отчёта пока нет. Поработайте с сайтом и консолью несколько минут и загляните снова."

msgid "“Block” closes the connection completely. “Cache” is for licenses: the same valid response is kept for a few hours and the license is not cut off."
msgstr "«Блокировать» полностью закрывает подключение. «Кэш» — для лицензий: один и тот же допустимый ответ хранится несколько часов, и лицензия не обрывается."

msgid "Select recommended (ads and notices)"
msgstr "Выбрать рекомендуемые (реклама и уведомления)"

msgid "Clear all"
msgstr "Снять все"

msgid "All"
msgstr "Все"

msgid "Search: plugin, domain or description…"
msgstr "Поиск: плагин, домен или описание…"

msgid "Seen only"
msgstr "Только замеченные"

msgid "Description and address"
msgstr "Описание и адрес"

msgid "Type"
msgstr "Тип"

msgid "Impact on speed"
msgstr "Влияние на скорость"

msgid "Block"
msgstr "Блокировать"

msgid "Cache"
msgstr "Кэш"

msgid "Not seen yet"
msgstr "Пока не замечено"

msgid "Blocking “license” and “plugin function” items may lock a theme or stop SMS and orders from working. For licenses, “cache” is safer. If you tick both “block” and “cache”, block wins."
msgstr "Блокировка «лицензий» и «функций плагина» может заблокировать тему или остановить работу SMS и заказов. Для лицензий безопаснее «кэш». Если отметить и «блокировать», и «кэш», приоритет у блокировки."

msgid "Connections seen on your site"
msgstr "Подключения, замеченные на вашем сайте"

msgid "Items that are not in the known list, ordered by longest wait. Tick one to block that address."
msgstr "Элементы, которых нет в списке известных, по убыванию времени ожидания. Отметьте, чтобы заблокировать адрес."

msgid "No new connection has been recorded yet. Work with the site and the dashboard for a while and check again."
msgstr "Новых подключений пока не записано. Поработайте с сайтом и консолью некоторое время и загляните снова."

msgid "Type (guess)"
msgstr "Тип (предположение)"

msgid "Search the connections seen…"
msgstr "Поиск по замеченным подключениям…"

msgid "Take a whole plugin offline"
msgstr "Полностью отключить плагин от сети"

msgid "All external connections of the selected plugin are closed (only wordpress.org stays open). Use it only for plugins that do not need the internet or a license."
msgstr "Все внешние подключения выбранного плагина закрываются (открытым остаётся только wordpress.org). Используйте только для плагинов, которым не нужны интернет и лицензия."

msgid "Search plugin…"
msgstr "Поиск плагина…"

msgid "Ready-made widgets and ads"
msgstr "Готовые виджеты и реклама"

msgid "Each item is switched on separately."
msgstr "Каждый пункт включается отдельно."

msgid "WordPress news widget"
msgstr "Виджет новостей WordPress"

msgid "“Events and News” and the planet news."
msgstr "«События и новости» и новости планеты."

msgid "ParsiDate: widget and ads"
msgstr "ParsiDate: виджет и реклама"

msgid "The dashboard widget (sponsor banner such as Files.ir and the news feed) is removed and the sponsors.json and wp-parsi.com connections are closed. The Jalali calendar stays untouched."
msgstr "Виджет консоли (баннер спонсоров, например Files.ir, и лента новостей) удаляется, а подключения sponsors.json и wp-parsi.com закрываются. Солнечный календарь Хиджры остаётся нетронутым."

msgid "Elementor news widget"
msgstr "Виджет новостей Elementor"

msgid "Version and tool ads."
msgstr "Реклама версий и инструментов."

msgid "Yoast widget feed"
msgstr "Лента виджета Yoast"

msgid "The SEO score stays; only the English feed is hidden."
msgstr "Оценка SEO остаётся; скрывается только английская лента."

msgid "Jetpack: offline mode"
msgstr "Jetpack: автономный режим"

msgid "The connection to WordPress.com and the Jetpack connections (including the bundle inside WooCommerce) are cut."
msgstr "Подключение к WordPress.com и соединения Jetpack (включая пакет внутри WooCommerce) отключаются."

msgid "Persian WooCommerce SMS ads"
msgstr "Реклама SMS персидского WooCommerce"

msgid "The national SMS banner and plugin install suggestions."
msgstr "Национальный SMS-баннер и предложения установить плагины."

msgid "Hide promotional notices"
msgstr "Скрывать рекламные уведомления"

msgid "Errors and “new version” notices always stay."
msgstr "Ошибки и уведомления «новая версия» остаются всегда."

msgid "Enable the keyword filter for notices"
msgstr "Включить фильтр уведомлений по ключевым словам"

msgid "One keyword per line, for example: Digits jacket"
msgstr "По одному ключевому слову в строке, например: Digits jacket"

msgid "Dashboard widgets of this site"
msgstr "Виджеты консоли этого сайта"

msgid "(one switch each)"
msgstr "(у каждого свой переключатель)"

msgid "All the widgets that have been seen on this site's dashboard, with the name of the plugin that created them. A ticked widget is never created, so its feed and ad banner are not fetched from an external server either."
msgstr "Все виджеты, замеченные в консоли этого сайта, с именем создавшего их плагина. Отмеченный виджет вообще не создаётся, поэтому его лента и рекламный баннер не загружаются с внешнего сервера."

msgid "Admin menu (right side)"
msgstr "Меню администрирования (сбоку)"

msgid "(only hidden, not removed)"
msgstr "(только скрывается, не удаляется)"

msgid "Every ticked item is hidden from the side menu. The plugin stays active and its settings still open by direct address. “Dashboard”, “Settings” and “Plugins” are not in this list so you never lose access."
msgstr "Каждый отмеченный пункт скрывается из бокового меню. Плагин остаётся активным, а его настройки открываются по прямому адресу. «Консоль», «Настройки» и «Плагины» отсутствуют в этом списке, чтобы вы не потеряли доступ."

msgid "There is no list yet. Open another admin page and come back here."
msgstr "Списка пока нет. Откройте другую страницу администрирования и вернитесь сюда."

msgid "Remove dashboard widgets of the selected plugins"
msgstr "Удалить виджеты консоли выбранных плагинов"

msgid "The widget code does not run and its feed and banner are not fetched from an external server."
msgstr "Код виджета не выполняется, а его лента и баннер не загружаются с внешнего сервера."

msgid "Servers in some regions (such as Iran) sometimes cannot reach external services and wait 5 to 15 seconds every time. With this option, a host that keeps failing or is slow in a row is skipped for a while without waiting."
msgstr "Серверы в некоторых регионах (например, в Иране) иногда не достигают внешних сервисов и каждый раз ждут от 5 до 15 секунд. С этой опцией хост, который подряд даёт сбои или работает медленно, на время пропускается без ожидания."

msgid "Enable"
msgstr "Включить"

msgid "Off by default. “License” addresses are always exempt."
msgstr "По умолчанию выключено. Адреса «лицензий» всегда исключены."

msgid "How long a failing host is skipped (hours)"
msgstr "Как долго пропускать неисправный хост (часы)"

msgid "Consecutive failures before it activates"
msgstr "Сбоев подряд до срабатывания"

msgid "A response slower than this (seconds) also counts as a failure"
msgstr "Ответ медленнее этого значения (в секундах) тоже считается сбоем"

msgid "Exempt hosts (one per line)"
msgstr "Исключённые хосты (по одному в строке)"

msgid "These hosts (and their subdomains) are never skipped, even if they are slow or failing. You can also exempt hosts from the table beside this one."
msgstr "Эти хосты (и их поддомены) никогда не пропускаются, даже если они медленные или неисправные. Исключать хосты можно и в таблице рядом."

msgid "Hosts being watched"
msgstr "Отслеживаемые хосты"

msgid "Only failures recorded since this option was switched on are shown. After the skip period ends it tries once more; if the host is healthy it is removed from the list."
msgstr "Показаны только сбои, записанные с момента включения этой опции. После окончания периода пропуска выполняется ещё одна попытка; если хост исправен, он удаляется из списка."

msgid "No host has been recorded yet."
msgstr "Ни один хост пока не записан."

msgid "Host"
msgstr "Хост"

msgid "Status"
msgstr "Статус"

msgid "Skip ends"
msgstr "Конец пропуска"

msgid "Times activated"
msgstr "Срабатываний"

msgid "Last error"
msgstr "Последняя ошибка"

msgid "Exempt from the breaker"
msgstr "Исключён из предохранителя"

msgid "Release all (clear the list)"
msgstr "Сбросить всё (очистить список)"

msgid "1) Intercept direct PHP connections"
msgstr "1) Перехват прямых подключений PHP"

msgid "Enable deep tracking"
msgstr "Включить глубокое отслеживание"

msgid "Off by default. Try it on a test site first."
msgstr "По умолчанию выключено. Сначала попробуйте на тестовом сайте."

msgid "2) Plugin code scan (static)"
msgstr "2) Сканирование кода плагинов (статическое)"

msgid "Scan plugin code"
msgstr "Сканировать код плагинов"

msgid "Nothing found."
msgstr "Ничего не найдено."

msgid "Plugin's own code"
msgstr "Собственный код плагина"

msgid "Library (vendor)"
msgstr "Библиотека (vendor)"

msgid "Fixed destinations in code"
msgstr "Фиксированные адреса назначения в коде"

msgid "File details were not saved in this scan; scan again."
msgstr "Подробности файлов в этом сканировании не сохранены; просканируйте снова."

msgid "File"
msgstr "Файл"

msgid "Line"
msgstr "Строка"

msgid "Site / fixed IP inside the file"
msgstr "Сайт / фиксированный IP в файле"

msgid "Library"
msgstr "Библиотека"

msgid "Plugin code"
msgstr "Код плагина"

msgid "“Plugin's own code” means outside the vendor folder. A high count inside libraries is usually harmless. False positives are possible too (for example curl for a local address); to be sure, follow that plugin in the “seen” table."
msgstr "«Собственный код плагина» означает код вне папки vendor. Большое число внутри библиотек обычно безвредно. Возможны и ложные срабатывания (например, curl для локального адреса); для уверенности отслеживайте этот плагин в таблице «замеченных»."

msgid "Manual blocking"
msgstr "Ручная блокировка"

msgid "Save settings"
msgstr "Сохранить настройки"

msgid "No changes made"
msgstr "Изменений нет"

msgid "Clear the connection report"
msgstr "Очистить отчёт о подключениях"

msgid "The mu-plugins folder could not be created: %s"
msgstr "Не удалось создать папку mu-plugins: %s"

msgid "The mu-plugins folder is not writable; the plugin works normally but loads later than the others."
msgstr "Папка mu-plugins недоступна для записи; плагин работает как обычно, но загружается позже остальных."

msgid "Writing the loader file failed."
msgstr "Не удалось записать файл загрузчика."

msgid "Loader installed: %s"
msgstr "Загрузчик установлен: %s"

msgid "NIVA WP Guard — connection report"
msgstr "NIVA WP Guard — отчёт о подключениях"

msgid "Site: %1$s | Date: %2$s UTC | Version: %3$s"
msgstr "Сайт: %1$s | Дата: %2$s UTC | Версия: %3$s"

msgid "The log file has not been created yet."
msgstr "Файл журнала ещё не создан."

msgid "Unique connections: %1$d | Slow connections (over 0.5 s): %2$d | Total wait: %3$.1f s | Errors / no response: %4$d"
msgstr "Уникальных подключений: %1$d | Медленных (дольше 0,5 с): %2$d | Общее ожидание: %3$.1f с | Ошибок / без ответа: %4$d"

msgid "— By plugin (total wait time):"
msgstr "— По плагинам (общее время ожидания):"

msgid "— Slowest addresses:"
msgstr "— Самые медленные адреса:"

msgid "  %1$-60s  %2$d times  total %3$.1fs  max %4$.1fs  errors:%5$d  [%6$s]"
msgstr "  %1$-60s  %2$d раз  всего %3$.1fs  макс. %4$.1fs  ошибок:%5$d  [%6$s]"

msgid "Persian WooCommerce SMS"
msgstr "SMS для персидского WooCommerce"

msgid "Persian WooCommerce"
msgstr "Персидский WooCommerce"

msgid "Digits (Mersa Web)"
msgstr "Digits (Mersa Web)"

msgid "RTL (RTL-CareUnit)"
msgstr "RTL (RTL-CareUnit)"

msgid "Mahdis Web theme"
msgstr "Тема Mahdis Web"

msgid "Buy with Digikala"
msgstr "Покупка через Digikala"

msgid "WooCommerce"
msgstr "WooCommerce"

msgid "WordPress — version and plugin updates"
msgstr "WordPress — обновления версии и плагинов"

msgid "Elementor"
msgstr "Elementor"

msgid "Yoast (unofficial server)"
msgstr "Yoast (неофициальный сервер)"

msgid "ParsiDate"
msgstr "ParsiDate"

msgid "Advanced Shipping (Ace Plugins)"
msgstr "Advanced Shipping (Ace Plugins)"

msgid "Emalls"
msgstr "Emalls"

msgid "Niva plugins"
msgstr "Плагины Niva"

msgid "SMS"
msgstr "SMS"

msgid "Torob"
msgstr "Torob"

msgid "Notices and ads (pwsms.json / pwsms.hash)"
msgstr "Уведомления и реклама (pwsms.json / pwsms.hash)"

msgid "Notice signature"
msgstr "Подпись уведомлений"

msgid "News feed on the dashboard"
msgstr "Лента новостей в консоли"

msgid "Advertising panel (ads-api)"
msgstr "Рекламная панель (ads-api)"

msgid "Notices and ads"
msgstr "Уведомления и реклама"

msgid "License verification (every few seconds)"
msgstr "Проверка лицензии (каждые несколько секунд)"

msgid "Product authorization"
msgstr "Авторизация продукта"

msgid "News feed"
msgstr "Лента новостей"

msgid "Version notice (notifier.xml)"
msgstr "Уведомление о версии (notifier.xml)"

msgid "Notices (notifications.json)"
msgstr "Уведомления (notifications.json)"

msgid "Version check (metadata.json)"
msgstr "Проверка версии (metadata.json)"

msgid "Order registration and tracking (plugin function)"
msgstr "Регистрация и отслеживание заказов (функция плагина)"

msgid "Promotional offers and suggested extensions (promotions / obw-free-extensions)"
msgstr "Рекламные предложения и рекомендуемые расширения (promotions / obw-free-extensions)"

msgid "Connection to WordPress.com (public-api): account check, suggestions, payments"
msgstr "Подключение к WordPress.com (public-api): проверка аккаунта, предложения, платежи"

msgid "Jetpack server communication (jetpack.wordpress.com)"
msgstr "Связь с сервером Jetpack (jetpack.wordpress.com)"

msgid "The jetpack.com site — product recommendations and ads"
msgstr "Сайт jetpack.com — рекомендации и реклама продуктов"

msgid "Visit statistics (stats.wp.com)"
msgstr "Статистика посещений (stats.wp.com)"

msgid "Tracking pixel (pixel.wp.com)"
msgstr "Пиксель отслеживания (pixel.wp.com)"

msgid "WooPayments ads (incentives) — the “Set up WooPayments” banner; unrelated to your own payment gateways"
msgstr "Реклама WooPayments (incentives) — баннер «Настройте WooPayments»; не относится к вашим платёжным шлюзам"

msgid "Sending usage statistics to WooCommerce (usage tracking), about half a second"
msgstr "Отправка статистики использования в WooCommerce (usage tracking), около полусекунды"

msgid "PayPal (webscr): IPN validation and connecting to PayPal — can wait up to 15 seconds from servers that cannot reach PayPal"
msgstr "PayPal (webscr): проверка IPN и подключение к PayPal — до 15 секунд ожидания на серверах, не достигающих PayPal"

msgid "Product key check for WooCommerce.com products (product-key-api)"
msgstr "Проверка ключа продуктов WooCommerce.com (product-key-api)"

msgid "WordPress version check from api.wordpress.org (“System status” page; up to 10 seconds on slow hosts)"
msgstr "Проверка версии WordPress через api.wordpress.org (страница «Состояние системы»; до 10 секунд на медленных хостах)"

msgid "Theme information from api.wordpress.org (“System status” page)"
msgstr "Информация о теме с api.wordpress.org (страница «Состояние системы»)"

msgid "QUIC.cloud news and notices (wpapi.quic.cloud/news)"
msgstr "Новости и уведомления QUIC.cloud (wpapi.quic.cloud/news)"

msgid "QUIC.cloud version check (ver_check)"
msgstr "Проверка версии QUIC.cloud (ver_check)"

msgid "QUIC.cloud dashboard (api.quic.cloud/d/dash): statistics and cloud service suggestions"
msgstr "Панель QUIC.cloud (api.quic.cloud/d/dash): статистика и предложения облачных сервисов"

msgid "solidwp.com news and promotional posts (dashboard widget and notice), up to 10 seconds"
msgstr "Новости и рекламные записи solidwp.com (виджет и уведомление консоли), до 10 секунд"

