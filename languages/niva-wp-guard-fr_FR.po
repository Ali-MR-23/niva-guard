msgstr "Enregistrement et suivi des commandes (fonction de l’extension)"

msgid "Promotional offers and suggested extensions (promotions / obw-free-extensions)"
msgstr "Offres promotionnelles et extensions suggérées (promotions / obw-free-extensions)"

msgid "Connection to WordPress.com (public-api): account check, suggestions, payments"
msgstr "Connexion à WordPress.com (public-api) : vérification du compte, suggestions, paiements"

