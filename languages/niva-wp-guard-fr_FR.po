msgstr "Pixel de suivi (pixel.wp.com)"

msgid "WooPayments ads (incentives) — the “Set up WooPayments” banner; unrelated to your own payment gateways"
msgstr "Publicités WooPayments (incentives) — la bannière « Configurez WooPayments » ; sans lien avec vos propres passerelles de paiement"

msgid "Sending usage statistics to WooCommerce (usage tracking), about half a second"
msgstr "Envoi de statistiques d’utilisation à WooCommerce (usage tracking), environ une demi-seconde"

msgid "PayPal (webscr): IPN validation and connecting to PayPal — can wait up to 15 seconds from servers that cannot reach PayPal"
msgstr "PayPal (webscr) : validation IPN et connexion à PayPal — peut attendre jusqu’à 15 secondes sur les serveurs qui n’atteignent pas PayPal"

msgid "Product key check for WooCommerce.com products (product-key-api)"
msgstr "Vérification de la clé des produits WooCommerce.com (product-key-api)"

msgid "WordPress version check from api.wordpress.org (“System status” page; up to 10 seconds on slow hosts)"
msgstr "Vérification de la version de WordPress via api.wordpress.org (page « État du système » ; jusqu’à 10 secondes sur les hébergements lents)"

msgid "Theme information from api.wordpress.org (“System status” page)"
msgstr "Informations sur le thème via api.wordpress.org (page « État du système »)"

msgid "QUIC.cloud news and notices (wpapi.quic.cloud/news)"
msgstr "Actualités et avis QUIC.cloud (wpapi.quic.cloud/news)"

msgid "QUIC.cloud version check (ver_check)"
msgstr "Vérification de version QUIC.cloud (ver_check)"

msgid "QUIC.cloud dashboard (api.quic.cloud/d/dash): statistics and cloud service suggestions"
msgstr "Tableau de bord QUIC.cloud (api.quic.cloud/d/dash) : statistiques et suggestions de services cloud"

msgid "solidwp.com news and promotional posts (dashboard widget and notice), up to 10 seconds"
msgstr "Actualités et articles promotionnels de solidwp.com (widget et avis du tableau de bord), jusqu’à 10 secondes"

msgid "rankmath.com blog news and posts (news widget and dashboard ad)"
msgstr "Actualités et articles du blog rankmath.com (widget d’actualités et publicité du tableau de bord)"

msgid "Reading the readme from the WordPress svn (up to 10 seconds)"
msgstr "Lecture du readme depuis le svn de WordPress (jusqu’à 10 secondes)"

msgid "Plugin version check"
msgstr "Vérification de version des extensions"

msgid "Editor ads and notices: upgrade to Pro (free-to-pro-upsell), notifications and promotions — when the editor opens"
msgstr "Publicités et avis de l’éditeur : passage à Pro (free-to-pro-upsell), notifications et promotions — à l’ouverture de l’éditeur"

msgid "my.elementor.com connections (news, library, suggested plugins)"
msgstr "Connexions my.elementor.com (actualités, bibliothèque, extensions suggérées)"

msgid "Yoast SEO (free) translation packages (translationspress)"
msgstr "Paquets de traduction Yoast SEO (gratuit) (translationspress)"

msgid "Yoast SEO Premium translation packages (translationspress)"
msgstr "Paquets de traduction Yoast SEO Premium (translationspress)"

msgid "Yoast WooCommerce SEO translation packages (translationspress)"
msgstr "Paquets de traduction Yoast WooCommerce SEO (translationspress)"

msgid "All Yoast translation packages in one (including News, Local, Video and others)"
msgstr "Tous les paquets de traduction Yoast d’un coup (y compris News, Local, Video et autres)"

msgid "vip-themes.com — a third-party server, not Yoast"
msgstr "vip-themes.com — un serveur tiers, pas Yoast"

msgid "Visitor IP check (ipcheck) — also runs on site pages and can wait up to 10 seconds"
msgstr "Vérification de l’IP du visiteur (ipcheck) — s’exécute aussi sur les pages du site et peut attendre jusqu’à 10 secondes"

msgid "Add-ons list (addons) — up to 10 seconds"
msgstr "Liste des extensions complémentaires (addons) — jusqu’à 10 secondes"

msgid "Notices (feeds/notifications)"
msgstr "Avis (feeds/notifications)"

msgid "Sponsors list (sponsors.json from GitHub)"
msgstr "Liste des sponsors (sponsors.json depuis GitHub)"

msgid "News feed (wp-parsi.com)"
msgstr "Flux d’actualités (wp-parsi.com)"

msgid "Advertising page aceplugins.com"
msgstr "Page publicitaire aceplugins.com"

msgid "IndexNow — notifying search engines about page changes (up to 10 seconds)"
msgstr "IndexNow — informer les moteurs de recherche des changements de pages (jusqu’à 10 secondes)"

msgid "my.yoast.com — site information"
msgstr "my.yoast.com — informations sur le site"

msgid "Upgrade campaign (upgrade-campaign) — advertising; up to 10 seconds"
msgstr "Campagne de mise à niveau (upgrade-campaign) — publicité ; jusqu’à 10 secondes"

msgid "The entire Wincher connection (keyword tracking: account and connect/token) — up to 10 seconds; block it if you do not use Wincher"
msgstr "Toute la connexion Wincher (suivi de mots-clés : account et connect/token) — jusqu’à 10 secondes ; bloquez-la si vous n’utilisez pas Wincher"

msgid "Welcome page and ad (cs_welcome.json)"
msgstr "Page d’accueil et publicité (cs_welcome.json)"

msgid "Emalls product extraction service (plugin function)"
msgstr "Service d’extraction de produits Emalls (fonction de l’extension)"

msgid "Niva license server (validate)"
msgstr "Serveur de licences Niva (validate)"

msgid "payamak-panel SMS gateway"
msgstr "Passerelle SMS payamak-panel"

msgid "Price update webhook (Torob)"
msgstr "Webhook de mise à jour des prix (Torob)"

msgid "Ad"
msgstr "Publicité"

msgid "Notice / news"
msgstr "Avis / actualités"

msgid "License"
msgstr "Licence"

msgid "Version check"
msgstr "Vérification de version"

msgid "Plugin function"
msgstr "Fonction de l’extension"

msgid "Third party"
msgstr "Tiers"

msgid "Status summary: <b>%1$s</b> blocked, <b>%2$s</b> cached, <b>%3$s</b> plugins offline."
msgstr "Résumé de l’état : <b>%1$s</b> bloqués, <b>%2$s</b> en cache, <b>%3$s</b> extensions hors ligne."

msgid "<b>%1$s</b> unique connections · <b>%2$s</b> slow · total wait <b>%3$s</b> · <b>%4$s</b> errors or no response"
msgstr "<b>%1$s</b> connexions uniques · <b>%2$s</b> lentes · attente totale <b>%3$s</b> · <b>%4$s</b> erreurs ou sans réponse"

msgid "Skipped"
msgstr "Ignoré"

msgid "Counting (%s)"
msgstr "Comptage (%s)"

msgid "Waiting for next try"
msgstr "En attente du prochain essai"

msgid "Connections that bypass the WordPress API and go through <code>file_get_contents('http…')</code> or <code>fopen</code> are also recorded in the same table and log (tag \"PHP-GET\"), and the blocking rules apply to them too."
msgstr "Les connexions qui contournent l’API WordPress et passent par <code>file_get_contents('http…')</code> ou <code>fopen</code> sont aussi enregistrées dans le même tableau et le même journal (étiquette « PHP-GET »), et les règles de blocage s’y appliquent aussi."

msgid "Limits: <code>curl_exec</code> and <code>fsockopen</code> cannot be intercepted live in plain PHP (see section 2). Also, if a plugin reads <code>$http_response_header</code> or <code>get_headers()</code> directly, it may not receive the header data while this option is on; if anything breaks, turn this switch off. Requests made by WordPress core itself (without a calling plugin) are left untouched."
msgstr "Limites : <code>curl_exec</code> et <code>fsockopen</code> ne peuvent pas être interceptés en direct en PHP pur (voir la section 2). De plus, si une extension lit directement <code>$http_response_header</code> ou <code>get_headers()</code>, elle peut ne pas recevoir les en-têtes quand cette option est active ; si quelque chose casse, désactivez cet interrupteur. Les requêtes du noyau WordPress lui-même (sans extension appelante) ne sont pas touchées."

msgid "allow_url_fopen is disabled on this host; this section has no effect."
msgstr "allow_url_fopen est désactivé sur cet hôte ; cette section est sans effet."

msgid "Reads the PHP files of all plugins and themes and lists where <code>curl</code>, <code>fsockopen</code> or <code>file_get_contents('http…')</code> is written directly. It does not run or block anything; it only tells you which plugin has the “ability to connect silently”."
msgstr "Lit les fichiers PHP de toutes les extensions et de tous les thèmes et liste les endroits où <code>curl</code>, <code>fsockopen</code> ou <code>file_get_contents('http…')</code> est écrit directement. Il n’exécute ni ne bloque rien ; il indique seulement quelle extension a la « capacité de se connecter en silence »."

msgid "Last scan: %1$s · %2$s files"
msgstr "Dernière analyse : %1$s · %2$s fichiers"

msgid "· partial (time ran out)"
msgstr "· partielle (temps écoulé)"

msgid "No fixed address — the destination comes from settings or input at run time"
msgstr "Aucune adresse fixe — la destination vient des réglages ou des entrées à l’exécution"

msgid "One address per line in the form <code>domain/path</code> (prefix); for example <code>example.com/ads/</code>"
msgstr "Une adresse par ligne sous la forme <code>domaine/chemin</code> (préfixe) ; par exemple <code>example.com/ads/</code>"

msgid "%s items"
msgstr "%s éléments"

msgid "This item is of the “license” type. Blocking it may lock a theme or plugin. Turn on “cache” instead. Continue?"
msgstr "Cet élément est de type « licence ». Le bloquer peut verrouiller un thème ou une extension. Activez plutôt le « cache ». Continuer ?"

msgid "This item is needed for the plugin itself to work (SMS, orders, etc.). Continue?"
msgstr "Cet élément est nécessaire au fonctionnement de l’extension elle-même (SMS, commandes, etc.). Continuer ?"

msgid "%s unsaved changes"
msgstr "%s modifications non enregistrées"

msgid "Copied ✓"
msgstr "Copié ✓"

msgid "Clear the connection report and log file?"
msgstr "Effacer le rapport de connexions et le fichier journal ?"

msgid "%1$s times · %2$s ·"
msgstr "%1$s fois · %2$s ·"

msgid "max %s"
msgstr "max %s"

msgid "WordPress core"
msgstr "Noyau WordPress"

msgid "Theme: %s"
msgstr "Thème : %s"

msgid "There is no list yet. Open the <a href=\"%s\">Dashboard</a> page once and come back here."
msgstr "Aucune liste pour le moment. Ouvrez une fois la page <a href=\"%s\">Tableau de bord</a> et revenez ici."

msgid "Control the outgoing connections of plugins and themes: log every connection with its timing (txt file and report), block ads, notices and news feeds, cache license responses (without cutting them off), take chosen plugins offline, remove promotional dashboard widgets and notices, and skip failing hosts automatically. Every item has its own switch and setup is automatic on every new site."
msgstr "Contrôlez les connexions sortantes des extensions et des thèmes : enregistrez chaque connexion avec son temps (fichier txt et rapport), bloquez publicités, avis et flux d’actualités, mettez en cache les réponses de licence (sans les couper), mettez des extensions choisies hors ligne, supprimez les widgets et avis promotionnels du tableau de bord et ignorez automatiquement les hôtes défaillants. Chaque élément a son propre interrupteur et l’installation est automatique sur chaque nouveau site."

msgid "The old “NIVA HTTP Guard” plugin is still active. Deactivate it so the new version can work. Your settings are migrated automatically and you can delete the old plugin after the first load."
msgstr "L’ancienne extension « NIVA HTTP Guard » est encore active. Désactivez-la pour que la nouvelle version fonctionne. Vos réglages sont migrés automatiquement et vous pouvez supprimer l’ancienne extension après le premier chargement."

msgid "Relevant to this site"
msgstr "Pertinent pour ce site"

msgid "All connections"
msgstr "Toutes les connexions"

msgid ".htaccess is up to date (a backup was saved)."
msgstr ".htaccess est à jour (une sauvegarde a été enregistrée)."

msgid "The .htaccess block was removed."
msgstr "Le bloc .htaccess a été supprimé."

msgid "404.html was regenerated."
msgstr "404.html a été régénéré."

msgid "Could not write 404.html — download it and upload it to the site root."
msgstr "Impossible d’écrire 404.html — téléchargez-le et placez-le à la racine du site."

msgid "The site returned a server error after the change, so .htaccess was restored from the backup."
msgstr "Le site a renvoyé une erreur serveur après la modification ; .htaccess a donc été restauré depuis la sauvegarde."

msgid "This server uses Nginx, which does not use .htaccess. Use the Nginx snippet below."
msgstr "Ce serveur utilise Nginx, qui n’utilise pas .htaccess. Utilisez l’extrait Nginx ci-dessous."

msgid "Enable Fast 404 and save first."
msgstr "Activez d’abord « 404 rapide » et enregistrez."

msgid "Could not write .htaccess — download the snippet below and add it yourself."
msgstr "Impossible d’écrire .htaccess — téléchargez l’extrait ci-dessous et ajoutez-le vous-même."

msgid "Server and 404"
msgstr "Serveur et 404"

msgid "Installed"
msgstr "Installé"

msgid "Outdated — it is updated when you save"
msgstr "Obsolète — mis à jour à l’enregistrement"

msgid "Still present — it is removed when you save"
msgstr "Toujours présent — supprimé à l’enregistrement"

msgid "Not writable"
msgstr "Non inscriptible"

msgid "Your own file (kept untouched)"
msgstr "Votre propre fichier (laissé intact)"

msgid "Not used on Nginx"
msgstr "Non utilisé sous Nginx"

msgid "Off"
msgstr "Désactivé"

msgid "WordPress default"
msgstr "Par défaut de WordPress"

msgid "Slow down (use the interval)"
msgstr "Ralentir (utiliser l’intervalle)"

msgid "Turn off"
msgstr "Désactiver"

msgid "Post editor"
msgstr "Éditeur d’articles"

msgid "Other admin pages"
msgstr "Autres pages d’administration"

msgid "Front-end (visitors)"
msgstr "Front-end (visiteurs)"

msgid "Heartbeat control"
msgstr "Contrôle de Heartbeat"

msgid "WordPress sends a background request (Heartbeat) every 15–60 seconds for autosave, post locking and notices. On weak hosts this alone can overload the server. Control it separately for each part of the site."
msgstr "WordPress envoie toutes les 15 à 60 secondes une requête en arrière-plan (Heartbeat) pour l’enregistrement automatique, le verrouillage des articles et les notifications. Sur les hébergements faibles, cela suffit à surcharger le serveur. Contrôlez-la séparément pour chaque partie du site."

msgid "Enable heartbeat control"
msgstr "Activer le contrôle de Heartbeat"

msgid "A separate mu-plugin file is created; off = default WordPress behavior."
msgstr "Un fichier mu-plugin distinct est créé ; désactivé = comportement par défaut de WordPress."

msgid "Interval when slowed (seconds)"
msgstr "Intervalle en mode ralenti (secondes)"

msgid "For example 300 = every 5 minutes, 600 = every 10 minutes."
msgstr "Par exemple 300 = toutes les 5 minutes, 600 = toutes les 10 minutes."

msgid "Turning it off in the post editor disables autosave and post locking while editing."
msgstr "Le désactiver dans l’éditeur d’articles supprime l’enregistrement automatique et le verrouillage pendant l’édition."

msgid "mu-plugin file"
msgstr "Fichier mu-plugin"

msgid "Fast 404"
msgstr "404 rapide"

msgid "Scanner bots probe hundreds of strange addresses (.env, backup files, fake PHP files). Instead of loading WordPress, the database, CSS and JS for each one, a light static 404 page is returned immediately."
msgstr "Les robots scanners testent des centaines d’adresses étranges (.env, fichiers de sauvegarde, faux fichiers PHP). Au lieu de charger WordPress, la base de données, le CSS et le JS pour chacune, une page 404 statique et légère est renvoyée immédiatement."

msgid "Enable fast 404"
msgstr "Activer le 404 rapide"

msgid "Creates a separate mu-plugin, a 404.html page in the site root and a block in .htaccess."
msgstr "Crée un mu-plugin distinct, une page 404.html à la racine du site et un bloc dans .htaccess."

msgid "Strict mode"
msgstr "Mode strict"

msgid "Also blocks existing script files outside the WordPress core, plugins and themes folders. May break custom scripts placed in the site root."
msgstr "Bloque aussi les fichiers de script existants hors des dossiers du noyau WordPress, des extensions et des thèmes. Peut casser des scripts personnalisés placés à la racine du site."

msgid "Installation status"
msgstr "État de l’installation"

msgid "404.html page"
msgstr "Page 404.html"

msgid ".htaccess block"
msgstr "Bloc .htaccess"

msgid "Install / repair .htaccess"
msgstr "Installer / réparer .htaccess"

msgid "Regenerate 404.html"
msgstr "Régénérer 404.html"

msgid "Remove .htaccess block"
msgstr "Supprimer le bloc .htaccess"

msgid "Download 404.html"
msgstr "Télécharger 404.html"

msgid "Download Nginx snippet"
msgstr "Télécharger l’extrait Nginx"

msgid "Download .htaccess snippet"
msgstr "Télécharger l’extrait .htaccess"

msgid "Nginx configuration"
msgstr "Configuration Nginx"

msgid "Code to add to .htaccess"
msgstr "Code à ajouter à .htaccess"

msgid "Nginx does not use .htaccess; add this to your server configuration. Fake PHP files are handled by the mu-plugin."
msgstr "Nginx n’utilise pas .htaccess ; ajoutez ceci à la configuration de votre serveur. Les faux fichiers PHP sont gérés par le mu-plugin."

msgid "If automatic installation is not possible, download the files and place them yourself: put 404.html in the site root (next to wp-config.php) and add this code to the top of .htaccess (before “# BEGIN WordPress”)."
msgstr "Si l’installation automatique est impossible, téléchargez les fichiers et placez-les vous-même : mettez 404.html à la racine du site (à côté de wp-config.php) et ajoutez ce code en haut de .htaccess (avant « # BEGIN WordPress »)."

msgid "Load before other plugins (mu-plugin loader)"
msgstr "Charger avant les autres extensions (chargeur mu-plugin)"

msgid "Creates one small file in wp-content/mu-plugins. Nothing is created outside the plugin folder until you turn this on and save."
msgstr "Un petit fichier est créé dans wp-content/mu-plugins. Rien n’est créé en dehors du dossier de l’extension tant que vous n’activez pas ceci et n’enregistrez pas."

msgid "DISABLE_WP_CRON is already defined in wp-config.php by you, so it was left untouched."
msgstr "DISABLE_WP_CRON est déjà défini par vous dans wp-config.php ; il a été laissé tel quel."

msgid "The site returned a server error after the change, so wp-config.php was restored."
msgstr "Le site a renvoyé une erreur serveur après la modification, wp-config.php a donc été restauré."

msgid "Could not find the right place in wp-config.php — add the line shown in the cron card yourself."
msgstr "Impossible de trouver le bon emplacement dans wp-config.php — ajoutez vous-même la ligne affichée dans la carte cron."

msgid "wp-config.php could not be changed automatically — add the line shown in the cron card yourself."
msgstr "wp-config.php n’a pas pu être modifié automatiquement — ajoutez vous-même la ligne affichée dans la carte cron."

msgid "WordPress cron (wp-cron)"
msgstr "Cron WordPress (wp-cron)"

msgid "By default WordPress runs its scheduled tasks (scheduled posts, emails, backups, WooCommerce jobs) during visitors’ page loads. This slows pages down and wastes resources. Turn it off here and let the server run it on a fixed schedule instead."
msgstr "Par défaut, WordPress exécute ses tâches planifiées (articles programmés, e-mails, sauvegardes, tâches WooCommerce) pendant le chargement des pages par les visiteurs. Cela ralentit les pages et gaspille des ressources. Désactivez-le ici et laissez le serveur l’exécuter selon un calendrier fixe."

msgid "Disable the built-in WordPress cron"
msgstr "Désactiver le cron intégré de WordPress"

msgid "Adds DISABLE_WP_CRON to wp-config.php. Add the server cron job below first, otherwise scheduled tasks stop running."
msgstr "Ajoute DISABLE_WP_CRON à wp-config.php. Ajoutez d’abord la tâche cron du serveur ci-dessous, sinon les tâches planifiées s’arrêtent."

msgid "Run the server job every"
msgstr "Exécuter la tâche serveur toutes les"

msgid "%s minutes"
msgstr "%s minutes"

msgid "5 minutes suits most sites and shops, 15 minutes is enough for a blog. Use 1 minute only if you need exact timing; more frequent runs only load the server."
msgstr "5 minutes conviennent à la plupart des sites et boutiques, 15 minutes suffisent pour un blog. N’utilisez 1 minute que pour un horaire précis ; des exécutions plus fréquentes ne font que charger le serveur."

msgid "wp-config.php setting"
msgstr "Réglage wp-config.php"

msgid "Scheduled tasks are %s minutes overdue. Check that the server cron job below exists."
msgstr "Les tâches planifiées ont %s minutes de retard. Vérifiez que la tâche cron du serveur ci-dessous existe."

msgid "Cron job for cPanel"
msgstr "Tâche cron pour cPanel"

msgid "In cPanel open “Cron Jobs” → “Add New Cron Job”. Enter the schedule (or choose the matching “Common Settings”), paste the command and save."
msgstr "Dans cPanel, ouvrez « Cron Jobs » → « Add New Cron Job ». Saisissez la planification (ou choisissez le « Common Settings » correspondant), collez la commande et enregistrez."

msgid "Schedule (minute, hour, day, month, weekday)"
msgstr "Planification (minute, heure, jour, mois, jour de la semaine)"

msgid "Command (matches this site’s PHP %s)"
msgstr "Commande (adaptée à PHP %s de ce site)"

msgid "Other panels and alternative command"
msgstr "Autres panneaux et commande alternative"

msgid "The command uses the cPanel path for PHP %1$s (%2$s). On DirectAdmin or other panels replace that path with the PHP path your panel shows for the same version, for example /usr/local/php82/bin/php."
msgstr "La commande utilise le chemin cPanel pour PHP %1$s (%2$s). Sous DirectAdmin ou d’autres panneaux, remplacez-le par le chemin PHP que votre panneau affiche pour la même version, par exemple /usr/local/php82/bin/php."

msgid "If the command above does not run, use this one. It calls the cron file through the web address."
msgstr "Si la commande ci-dessus ne s’exécute pas, utilisez celle-ci ; elle appelle le fichier cron par l’adresse web."

msgid "If wp-config.php cannot be changed automatically, add this line above “That’s all, stop editing!”:"
msgstr "Si wp-config.php ne peut pas être modifié automatiquement, ajoutez cette ligne au-dessus de « That’s all, stop editing! » :"

msgid "%s hours"
msgstr "%s heures"

msgid "Longer intervals (hours) lower the server load the most, but scheduled posts, emails and WooCommerce jobs then run later (up to that interval)."
msgstr "Les intervalles plus longs (en heures) allègent le plus le serveur, mais les articles programmés, e-mails et tâches WooCommerce s’exécutent plus tard (jusqu’à cet intervalle)."

msgid "This is the full line (schedule + command), ready for crontab. In the cPanel form, enter the schedule in the time fields and paste only the part after it into the Command field."
msgstr "Voici la ligne complète (planification + commande), prête pour crontab. Dans le formulaire cPanel, saisissez la planification dans les champs de temps et collez uniquement la partie qui suit dans le champ Command."

msgid "Cron activity"
msgstr "Activité du cron"

msgid "Last successful run"
msgstr "Dernière exécution réussie"

msgid "Not recorded yet"
msgstr "Pas encore enregistré"

msgid "Last failed run"
msgstr "Dernière exécution échouée"

msgid "Next scheduled task"
msgstr "Prochaine tâche planifiée"

msgid "Run by"
msgstr "Lancé par"

msgid "Server cron command"
msgstr "Commande cron du serveur"

msgid "Web request (visitor or URL)"
msgstr "Requête web (visiteur ou URL)"

msgid "%s ago"
msgstr "il y a %s"

msgid "in %s"
msgstr "dans %s"

msgid "Copy command only"
msgstr "Copier uniquement la commande"

